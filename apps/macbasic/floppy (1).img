{
 "format": "MACBASIC-FLOPPY-V1",
 "created": "2026-09-02T01:20:16.806Z",
 "programs": {
  "7": "10 REM SAFE STRINGS BLOCK CLOCK\n20 PRINT CHR$(147):DIM D$(9,2):BL$=CHR$(160):SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=0 TO 2:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM SETUP DISPLAY ROW\n90 PRINT CHR$(147);:POKE214,10:PRINT:PRINT TAB(4);\n100 H1=INT(HR/10):H2=HR-H1*10:M1=INT(MN/10):M2=MN-M1*10\n110 S1=INT(SC/10):S2=SC-S1*10\n120 S$=D$(H1,R)+SP$+D$(H2,R)+SP$\n130 S$=S$+D$(M1,R)+SP$+D$(M2,R)+SP$\n140 S$=S$+D$(S1,R)+SP$+D$(S2,R)\n150 FOR B=1 TO LEN(S$):C$=MID$(S$,B,1)\n160 IF C$=\"#\" THEN PRINT BL$;\n170 IF C$=\".\" THEN PRINT SP$;\n180 NEXT B:PRINT:PRINT TAB(4);:NEXT R\n190 FOR D=1 TO 900:NEXT D\n200 SC=SC+1:IF SC<60 THEN GOTO 90\n210 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n220 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n230 HR=0:GOTO 90\n1000 DATA ###,#.#,###, .#.,.#.,.#., ###,..#,###, ###,..#,###, #.#,###,..#\n1010 DATA ###,###,###, ###,###,###, ###,..#,..#, ###,###,###, ###,###,..#",
  "STARFIELDSIM": "10 REM ASCII WARP DRIVE STARFIELD\n20 DIM SX(20),SY(20),SZ(20)\n30 CLS:CX = 20:CY = 11\n40 FOR I = 1 TO 15\n50 SX(I) = (RND(1) * 40) - 20:SY(I) = (RND(1) * 22) - 11\n60 SZ(I) = INT(RND(1) * 10) + 1\n70 NEXT I\n80 REM MATRIX ANIMATION LAYER\n90 CLS:FOR Y = 1 TO 22:L$ = \"\"\n100 FOR X = 1 TO 39:ST$ = \" \"\n110 FOR I = 1 TO 15\n120 REM UPDATE EXPANDING VECTORS\n130 SZ(I) = SZ(I) - 0.5:IF SZ(I) <= 0 THEN GOTO 200\n140 EX = INT(SX(I) / SZ(I)) + CX\n150 EY = INT(SY(I) / SZ(I)) + CY\n160 IF EX = X AND EY = Y THEN GOTO 180\n170 GOTO 190\n180 IF SZ(I) > 6 THEN ST$ = \".\"\n185 IF SZ(I) <= 6 AND SZ(I) > 3 THEN ST$ = \"*\"\n187 IF SZ(I) <= 3 THEN ST$ = \"O\"\n190 NEXT I\n195 L$ = L$ + ST$:NEXT X:PRINT L$:NEXT Y\n200 FOR D = 1 TO 9000:NEXT D\n210 FOR I = 1 TO 15:IF SZ(I) <= 0 THEN GOTO 50\n220 NEXT I:GOTO 90",
  "CLOCK": "10 REM APPLE IIE DIGITAL CLOCK\n20 TEXT : HOME\n30 PRINT \"ENTER STARTING TIME:\"\n40 INPUT \"HOURS (0-23): \";HR\n50 INPUT \"MINUTES (0-59): \";MN\n60 INPUT \"SECONDS (0-59): \";SC\n70 HOME\n80 HTAB 12: VTAB 12\n90 REM FORMAT AND PRINT TIME\n100 IF HR < 10 THEN PRINT \"0\";\n110 PRINT HR;\":\";\n120 IF MN < 10 THEN PRINT \"0\";\n130 PRINT MN;\":\";\n140 IF SC < 10 THEN PRINT \"0\";\n150 PRINT SC\n160 REM DELAY LOOP FOR 1 SECOND\n170 FOR D = 1 TO 460: NEXT D\n180 REM ADVANCE TIME CONTEXT\n190 SC = SC + 1\n200 IF SC < 60 THEN GOTO 70\n210 SC = 0: MN = MN + 1\n220 IF MN < 60 THEN GOTO 70\n230 MN = 0: HR = HR + 1\n240 IF HR < 24 THEN GOTO 70\n250 HR = 0: GOTO 70",
  "CLOCK-FINAL-A1": "10 REM GIANT 7X5 BLOCK CLOCK\n20 DIM D$(9,7):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 7:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 CLS:PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM DISPLAY LOOP\n90 CLS:FOR L=1 TO 5:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 7\n120 L$ = D$(H1,R) + SP$ + D$(H2,R)\n130 IF R=2 OR R=3 OR R=5 OR R=6 THEN L$ = L$ + \" : \"\n140 IF R<>2 AND R<>3 AND R<>5 AND R<>6 THEN L$ = L$ + \"   \"\n150 L$ = L$ + D$(M1,R) + SP$ + D$(M2,R)\n160 IF R=2 OR R=3 OR R=5 OR R=6 THEN L$ = L$ + \" : \"\n170 IF R<>2 AND R<>3 AND R<>5 AND R<>6 THEN L$ = L$ + \"   \"\n180 PRINT TAB(1); L$ + D$(S1,R) + SP$ + D$(S2,R)\n190 NEXT R\n200 FOR D=1 TO 950:NEXT D\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXXXX\",\"X   X\",\"X   X\",\"X   X\",\"X   X\",\"X   X\",\"XXXXX\"\n1010 DATA \"    X\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\"\n1020 DATA \"XXXXX\",\"    X\",\"    X\",\"XXXXX\",\"X    \",\"X    \",\"XXXXX\"\n1030 DATA \"XXXXX\",\"    X\",\"    X\",\"XXXXX\",\"    X\",\"    X\",\"XXXXX\"\n1040 DATA \"X   X\",\"X   X\",\"X   X\",\"XXXXX\",\"    X\",\"    X\",\"    X\"\n1050 DATA \"XXXXX\",\"X    \",\"X    \",\"XXXXX\",\"    X\",\"    X\",\"XXXXX\"\n1060 DATA \"XXXXX\",\"X    \",\"X    \",\"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\"\n1070 DATA \"XXXXX\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\"\n1080 DATA \"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\"\n1090 DATA \"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\",\"    X\",\"    X\",\"XXXXX\"",
  "CLOCKWSFINAL-ACCURATE": "10 REM SLEEP-SYNCHRONIZED BOUNCING CLOCK\n20 CLS:PRINT \"ENTER STARTING TIME:\"\n30 INPUT \"HOURS (0-23) \";HR\n40 INPUT \"MINUTES (0-59) \";MN\n50 INPUT \"SECONDS (0-59) \";SC\n60 REM INITIAL POSITION, DIRECTION, AND STEP COUNTER\n70 VP = 3: HP = 5: VD = 1: HD = 1: ST = 0\n80 REM MAIN DISPLAY LOOP\n90 CLS:IF VP < 1 THEN VP = 1\n100 FOR L = 1 TO VP:PRINT:NEXT L\n110 PRINT TAB(HP);\"+---------------------+\"\n120 PRINT TAB(HP);\"|                     |\"\n130 PRINT TAB(HP);\"|      \";\n140 IF HR < 10 THEN PRINT \"0\";\n150 PRINT HR;\":\";\n160 IF MN < 10 THEN PRINT \"0\";\n170 PRINT MN;\":\";\n180 IF SC < 10 THEN PRINT \"0\";\n190 PRINT SC;\"      |\"\n200 PRINT TAB(HP);\"|                     |\"\n210 PRINT TAB(HP);\"+---------------------+\"\n220 REM HARDWARE SLEEP LOCK FOR ACCURACY\n230 SLEEP 1\n240 REM TIME INCREMENT CALCULATION (EVERY 1 SECOND)\n250 SC = SC + 1:IF SC < 60 THEN GOTO 290\n260 SC = 0:MN = MN + 1:IF MN < 60 THEN GOTO 290\n270 MN = 0:HR = HR + 1:IF HR < 24 THEN GOTO 290\n280 HR = 0\n290 REM UPDATE SLOW PHYSICS (EVERY 10 SECONDS)\n300 ST = ST + 1:IF ST < 10 THEN GOTO 90\n310 ST = 0:REM RESET STEP COUNTER\n320 VP = VP + VD:IF VP >= 15 OR VP <= 1 THEN VD = -VD\n330 HP = HP + HD:IF HP >= 14 OR HP <= 1 THEN HD = -HD\n340 GOTO 90",
  "DIGITALRAIN": "10 REM THE MATRIX DIGITAL RAIN\n20 DIM C(40)\n30 CLS:REM INITIALIZE COLUMN DROPS\n40 FOR I = 1 TO 39:C(I) = INT(RND(1) * 20) + 1:NEXT I\n50 REM MAIN ANIMATION LOOP\n60 FOR I = 1 TO 39\n70 C(I) = C(I) + 1\n80 IF C(I) > 22 THEN C(I) = 1\n90 NEXT I\n100 REM RENDER THE SCREEN ROW BY ROW\n110 CLS:FOR Y = 1 TO 22\n120 L$ = \"\"\n130 FOR X = 1 TO 39\n140 REM CHOOSE TRAILING EFFECT OR SPACE\n150 IF C(X) = Y THEN L$ = L$ + CHR$(INT(RND(1) * 26) + 65):GOTO 180\n160 IF C(X) - 1 = Y OR C(X) - 2 = Y THEN L$ = L$ + CHR$(INT(RND(1) * 10) + 48):GOTO 180\n170 L$ = L$ + \" \"\n180 NEXT X\n190 PRINT L$\n200 NEXT Y\n210 REM CALIBRATED TIMING DELAY LOOP\n220 FOR D = 1 TO 15000:NEXT D\n230 GOTO 50",
  "CLOCK8": "10 REM UNIVERSAL STRINGS BLOCK CLOCK\n20 PRINT CHR$(147):DIM D$(9,2):BL$=CHR$(160):SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=0 TO 2:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM SETUP DISPLAY ROW\n90 PRINT CHR$(147);:FOR L=1 TO 10:PRINT:NEXT L:PRINT TAB(4);\n100 FOR R=0 TO 2\n110 H1=INT(HR/10):H2=HR-H1*10:M1=INT(MN/10):M2=MN-M1*10\n115 S1=INT(SC/10):S2=SC-S1*10\n120 S$=D$(H1,R)+SP$+D$(H2,R)+SP$\n130 S$=S$+D$(M1,R)+SP$+D$(M2,R)+SP$\n140 S$=S$+D$(S1,R)+SP$+D$(S2,R)\n150 FOR B=1 TO LEN(S$):C$=MID$(S$,B,1)\n160 IF C$=\"#\" THEN PRINT BL$;\n170 IF C$=\".\" THEN PRINT SP$;\n180 NEXT B:PRINT TAB(4);:NEXT R\n190 FOR D=1 TO 900:NEXT D\n200 SC=SC+1:IF SC<60 THEN GOTO 90\n210 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n220 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n230 HR=0:GOTO 90\n1000 DATA ###,#.#,###, .#.,.#.,.#., ###,..#,###, ###,..#,###, #.#,###,..#\n1010 DATA ###,###,###, ###,###,###, ###,..#,..#, ###,###,###, ###,###,..#",
  "MATRIX-RAIN": "10 REM THE MATRIX 80-COLUMN WIDESCREEN RAIN\n20 DIM C(80),ST(80)\n30 CLS:REM INITIALIZE ALL 80 HORIZONTAL COLUMNS\n40 FOR I = 1 TO 80\n50 ST(I) = INT(RND(1) * 2):REM 1 = RAINING, 0 = EMPTY\n60 C(I) = INT(RND(1) * 15) + 5:REM LENGTH OF STREAM\n70 NEXT I\n80 REM MAIN ANIMATION SCROLL LOOP\n90 FOR X = 1 TO 80\n100 REM UPDATE STREAM LIFESPAN\n110 C(X) = C(X) - 1\n120 IF C(X) <= 0 THEN ST(X) = INT(RND(1) * 2):C(X) = INT(RND(1) * 15) + 5\n130 REM CHOOSE CHARACTER AND PRINT INDIVIDUALLY\n140 IF ST(X) = 0 THEN PRINT \" \";:GOTO 180\n150 IF C(X) = 1 THEN PRINT CHR$(INT(RND(1) * 26) + 65);:GOTO 180\n160 PRINT CHR$(INT(RND(1) * 26) + 97);\n180 NEXT X\n190 REM CARRIAGE RETURN AT COLUMN 80 TRIGGERS SMOOTH SCROLL\n200 PRINT\n210 REM ADJUST STREAM FALL SPEED RHYTHM\n220 FOR D = 1 TO 2000:NEXT D\n230 GOTO 80",
  "CLOCK6": "10 REM SAFE STRINGS BLOCK CLOCK\n20 PRINT CHR$(147):DIM D$(9,2):BL$=CHR$(160):SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=0 TO 2:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 PRINT CHR$(147)\n90 FOR R=0 TO 2:FOR L=1 TO 8:PRINT:NEXT L:PRINT TAB(4);\n100 H1=INT(HR/10):H2=HR-H1*10:M1=INT(MN/10):M2=MN-M1*10\n110 S1=INT(SC/10):S2=SC-S1*10\n120 S$=D$(H1,R)+SP$+D$(H2,R)+SP$\n130 S$=S$+D$(M1,R)+SP$+D$(M2,R)+SP$\n140 S$=S$+D$(S1,R)+SP$+D$(S2,R)\n150 FOR B=1 TO LEN(S$):C$=MID$(S$,B,1)\n160 IF C$=\"#\" THEN PRINT BL$;\n170 IF C$=\".\" THEN PRINT SP$;\n180 NEXT B:PRINT:NEXT R\n190 FOR D=1 TO 900:NEXT D\n200 SC=SC+1:IF SC<60 THEN GOTO 80\n210 SC=0:MN=MN+1:IF MN<60 THEN GOTO 80\n220 MN=0:HR=HR+1:IF HR<24 THEN GOTO 80\n230 HR=0:GOTO 80\n1000 DATA ###,#.#,###, .#.,.#.,.#., ###,..#,###, ###,..#,###, #.#,###,..#\n1010 DATA ###,###,###, ###,###,###, ###,..#,..#, ###,###,###, ###,###,..#",
  "NUMBER_SQ": "10 FOR I = 1 TO 5\n20 PRINT I; \"SQUARED IS\"; I*I\n30 NEXT I",
  "RETRO_TRAIL_GAME": "10 REM LIGHTCYCLE TRAIL GAME\n20 DIM S(40,24)\n30 CLS:PRINT \"LIGHTCYCLE ARCADE v1.0\"\n40 PRINT \"CONTROLS: I=UP K=DOWN J=LEFT L=RIGHT\"\n50 PRINT:PRINT \"PRESS ANY KEY TO START...\"\n60 IF INKEY$ = \"\" THEN GOTO 60\n70 CLS:FOR X=1 TO 40:FOR Y=1 TO 24:S(X,Y)=0:NEXT Y:NEXT X\n80 PX = 20:PY = 12:DX = 1:DY = 0\n90 REM GAME LOOP\n100 K$ = INKEY$\n110 IF K$ = \"i\" OR K$ = \"I\" THEN DX = 0:DY = -1\n120 IF K$ = \"k\" OR K$ = \"K\" THEN DX = 0:DY = 1\n130 IF K$ = \"j\" OR K$ = \"J\" THEN DX = -1:DY = 0\n140 IF K$ = \"l\" OR K$ = \"L\" THEN DX = 1:DY = 0\n150 PX = PX + DX:PY = PY + DY\n160 REM COLLISION RADAR DETECTION\n170 IF PX < 1 OR PX > 39 OR PY < 1 OR PY > 23 THEN GOTO 250\n180 IF S(PX,PY) = 1 THEN GOTO 250\n190 S(PX,PY) = 1\n200 REM DRAW THE TRAIL AT COORDINATES\n210 CLS:FOR Y = 1 TO PY:PRINT:NEXT Y\n220 PRINT TAB(PX);\"O\"\n230 FOR D = 1 TO 8000:NEXT D\n240 GOTO 10\n250 CLS:PRINT \"   GAME OVER!\"\n260 PRINT \"YOU COLLIDED WITH A WALL OR TRAIL.\"",
  "CLOCK1": "10 REM COMMODORE 64 DIGITAL CLOCK\n20 PRINT CHR$(147)\n30 PRINT \"ENTER STARTING TIME:\"\n40 INPUT \"HOURS (0-23) \";HR\n50 INPUT \"MINUTES (0-59) \";MN\n60 INPUT \"SECONDS (0-59) \";SC\n70 PRINT CHR$(147)\n80 POKE 214,12: PRINT\n85 PRINT TAB(12);\n100 IF HR < 10 THEN PRINT \"0\";\n110 PRINT HR;\":\";\n120 IF MN < 10 THEN PRINT \"0\";\n130 PRINT MN;\":\";\n140 IF SC < 10 THEN PRINT \"0\";\n150 PRINT SC\n170 FOR D = 1 TO 850: NEXT D\n190 SC = SC + 1\n200 IF SC < 60 THEN GOTO 70\n210 SC = 0: MN = MN + 1\n220 IF MN < 60 THEN GOTO 70\n230 MN = 0: HR = HR + 1\n240 IF HR < 24 THEN GOTO 70\n250 HR = 0: GOTO 70",
  "CLOCK7": "10 REM SAFE STRINGS BLOCK CLOCK\n20 PRINT CHR$(147):DIM D$(9,2):BL$=CHR$(160):SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=0 TO 2:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM SETUP DISPLAY ROW\n90 PRINT CHR$(147);:POKE214,10:PRINT:PRINT TAB(4);\n100 H1=INT(HR/10):H2=HR-H1*10:M1=INT(MN/10):M2=MN-M1*10\n110 S1=INT(SC/10):S2=SC-S1*10\n120 S$=D$(H1,R)+SP$+D$(H2,R)+SP$\n130 S$=S$+D$(M1,R)+SP$+D$(M2,R)+SP$\n140 S$=S$+D$(S1,R)+SP$+D$(S2,R)\n150 FOR B=1 TO LEN(S$):C$=MID$(S$,B,1)\n160 IF C$=\"#\" THEN PRINT BL$;\n170 IF C$=\".\" THEN PRINT SP$;\n180 NEXT B:PRINT:PRINT TAB(4);:NEXT R\n190 FOR D=1 TO 900:NEXT D\n200 SC=SC+1:IF SC<60 THEN GOTO 90\n210 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n220 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n230 HR=0:GOTO 90\n1000 DATA ###,#.#,###, .#.,.#.,.#., ###,..#,###, ###,..#,###, #.#,###,..#\n1010 DATA ###,###,###, ###,###,###, ###,..#,..#, ###,###,###, ###,###,..#",
  "OREGON_TRAIL": "10 REM ==== OREGON TRAIL: TEXT EDITION ====\n20 PRINT \"OREGON TRAIL - TEXT EDITION\"\n30 PRINT \"THE YEAR IS 1848. LEAD YOUR WAGON PARTY 2000 MILES TO OREGON.\"\n40 PRINT \"\"\n50 MONEY = 400\n60 FOOD = 200\n70 HEALTH = 100\n80 OXEN = 2\n90 MILES = 0\n100 DAY = 1\n110 REM --- BUY SUPPLIES ---\n120 PRINT \"YOU HAVE $\"; MONEY; \" TO SPEND ON SUPPLIES.\"\n130 INPUT \"OXEN TO BUY (40 DOLLARS EACH)\"; BOX\n140 IF BOX * 40 > MONEY THEN PRINT \"YOU CANNOT AFFORD THAT.\" : GOTO 130\n150 OXEN = OXEN + BOX\n160 MONEY = MONEY - BOX * 40\n170 INPUT \"POUNDS OF FOOD TO BUY (0.2 DOLLARS PER LB)\"; BFOOD\n180 IF BFOOD * 0.2 > MONEY THEN PRINT \"YOU CANNOT AFFORD THAT.\" : GOTO 170\n190 FOOD = FOOD + BFOOD\n200 MONEY = MONEY - BFOOD * 0.2\n210 PRINT \"YOU HAVE $\"; MONEY; \" REMAINING. GOOD LUCK!\"\n220 PRINT \"\"\n230 REM ==== MAIN TRAVEL LOOP ====\n240 IF MILES >= 2000 THEN GOTO 900\n250 IF HEALTH <= 0 THEN GOTO 950\n260 IF FOOD <= 0 THEN HEALTH = HEALTH - 5\n270 PRINT \"DAY \"; DAY; \"  MILES: \"; MILES; \"  FOOD: \"; FOOD; \"  HEALTH: \"; HEALTH\n280 PRINT \"1) CONTINUE  2) HUNT  3) REST  4) CHECK STATUS\"\n290 INPUT \"YOUR CHOICE\"; CHOICE\n300 IF CHOICE = 1 THEN GOSUB 400\n310 IF CHOICE = 2 THEN GOSUB 500\n320 IF CHOICE = 3 THEN GOSUB 600\n330 IF CHOICE = 4 THEN GOSUB 700\n340 DAY = DAY + 1\n350 GOSUB 800\n360 GOTO 240\n400 REM --- CONTINUE TRAVELING ---\n410 D = 15 + INT(RND(1) * 10)\n420 MILES = MILES + D\n430 FOOD = FOOD - 10\n440 PRINT \"YOU TRAVELED \"; D; \" MILES.\"\n450 RETURN\n500 REM --- HUNT ---\n510 CATCH = INT(RND(1) * 60)\n520 FOOD = FOOD + CATCH\n530 PRINT \"YOU HUNTED AND GATHERED \"; CATCH; \" POUNDS OF FOOD.\"\n540 RETURN\n600 REM --- REST ---\n610 HEALTH = HEALTH + 10\n620 IF HEALTH > 100 THEN HEALTH = 100\n630 FOOD = FOOD - 5\n640 PRINT \"YOUR PARTY RESTS AND RECOVERS SOME HEALTH.\"\n650 RETURN\n700 REM --- CHECK STATUS ---\n710 PRINT \"MONEY: $\"; MONEY; \"  OXEN: \"; OXEN; \"  DAY: \"; DAY\n720 RETURN\n800 REM --- RANDOM EVENT ---\n810 EV = INT(RND(1) * 10)\n820 IF EV = 0 THEN PRINT \"A WHEEL BREAKS! YOU LOSE TIME AND STRENGTH.\" : HEALTH = HEALTH - 5\n830 IF EV = 1 THEN PRINT \"SOMEONE HAS DYSENTERY.\" : HEALTH = HEALTH - 10\n840 IF EV = 2 THEN PRINT \"YOU FIND A FRIENDLY TRADING POST.\" : FOOD = FOOD + 20\n850 IF EV = 3 THEN PRINT \"A RIVER CROSSING SOAKS YOUR SUPPLIES.\" : FOOD = FOOD - 15\n860 RETURN\n900 REM --- WIN ---\n910 PRINT \"\"\n920 PRINT \"CONGRATULATIONS! YOU REACHED OREGON ON DAY \"; DAY; \"!\"\n930 PRINT \"FINAL HEALTH: \"; HEALTH; \"  FOOD LEFT: \"; FOOD\n940 END\n950 REM --- LOSE ---\n960 PRINT \"\"\n970 PRINT \"YOUR PARTY HAS PERISHED ON THE TRAIL.\"\n980 PRINT \"YOU MADE IT \"; MILES; \" MILES BEFORE DAY \"; DAY; \".\"\n990 END",
  "STARBASE": "10 REM ==== STARBASE NUMBER HUNT ====\n20 PRINT \"STARBASE NUMBER HUNT\"\n30 PRINT \"GUESS THE SECRET NUMBER (1-100) IN AS FEW TRIES AS POSSIBLE.\"\n40 PRINT \"\"\n50 DIM SCORES(3)\n60 FOR ROUND = 1 TO 3\n70 T = INT(RND(1) * 100) + 1\n80 G = 0\n90 PRINT \"--- ROUND \"; ROUND; \" ---\"\n100 GOSUB 500\n110 SCORES(ROUND) = G\n120 NEXT ROUND\n130 PRINT \"\"\n140 PRINT \"FINAL RESULTS:\"\n150 TOTAL = 0\n160 FOR ROUND = 1 TO 3\n170 PRINT \"ROUND \"; ROUND; \": \"; SCORES(ROUND); \" GUESSES\"\n180 TOTAL = TOTAL + SCORES(ROUND)\n190 NEXT ROUND\n200 AVG = INT(TOTAL / 3 * 100 + 0.5) / 100\n210 PRINT \"AVERAGE GUESSES: \"; AVG\n220 IF AVG <= 5 THEN PRINT \"RANK: ACE NAVIGATOR\"\n230 IF AVG > 5 AND AVG <= 8 THEN PRINT \"RANK: SOLID PILOT\"\n240 IF AVG > 8 THEN PRINT \"RANK: KEEP PRACTICING, CADET\"\n250 END\n500 REM --- GUESS LOOP SUBROUTINE ---\n510 INPUT \"YOUR GUESS\"; GS\n520 G = G + 1\n530 IF GS = T THEN GOTO 570\n540 IF GS < T THEN PRINT \"TOO LOW\"\n550 IF GS > T THEN PRINT \"TOO HIGH\"\n560 GOTO 510\n570 PRINT \"CORRECT! IT TOOK YOU \"; G; \" GUESSES.\"\n580 RETURN",
  "PIC_GALLERY_FINAL": "10 REM ==== ULTIMATE 15-SCENE PIXEL GALLERY ====\n20 DIM SCNE(15):SC = 1\n30 REM ==== MAIN INTERACTIVE CYCLE CONTROLLER ====\n40 IF SC=1 THEN GOSUB 200:GOTO 56\n41 IF SC=2 THEN GOSUB 300:GOTO 56\n42 IF SC=3 THEN GOSUB 400:GOTO 56\n43 IF SC=4 THEN GOSUB 500:GOTO 56\n44 IF SC=5 THEN GOSUB 600:GOTO 56\n45 IF SC=6 THEN GOSUB 700:GOTO 56\n46 IF SC=7 THEN GOSUB 800:GOTO 56\n47 IF SC=8 THEN GOSUB 900:GOTO 56\n48 IF SC=9 THEN GOSUB 1000:GOTO 56\n49 IF SC=10 THEN GOSUB 1100:GOTO 56\n50 IF SC=11 THEN GOSUB 1200:GOTO 56\n51 IF SC=12 THEN GOSUB 1300:GOTO 56\n52 IF SC=13 THEN GOSUB 1400:GOTO 56\n53 IF SC=14 THEN GOSUB 1500:GOTO 56\n54 IF SC=15 THEN GOSUB 1600\n56 REM --- STABLE CALIBRATED 10-SECOND PAUSE LOOP ---\n60 FOR D = 1 TO 66000:NEXT D\n70 SC = SC + 1:IF SC > 15 THEN SC = 1\n80 GOTO 40\n200 REM --- SCENE 1: FOREST RIVER MEADOWS ---\n210 SCREEN 1:CLS:COLOR 11:FOR I=1 TO 30:PSET(INT(RND(1)*320),INT(RND(1)*80)):NEXT I\n220 COLOR 8:LINE(0,120)-(60,70):LINE(60,70)-(140,120):LINE(100,120)-(180,60):LINE(180,60)-(260,120)\n230 COLOR 2:LINE(0,120)-(319,199),2,BF\n240 COLOR 1:LINE(120,120)-(260,199),1:LINE(140,120)-(180,199),1\n250 PRINT:PRINT \"SCENE 1: FOREST RIVER MEADOWS\":RETURN\n300 REM --- SCENE 2: MAJESTIC MOUNTAINS TRAIL ---\n310 SCREEN 1:CLS:COLOR 8:LINE(0,140)-(80,60):LINE(80,60)-(160,140):LINE(120,140)-(220,50):LINE(220,50)-(319,140)\n320 COLOR 6:LINE(0,140)-(319,199),6,BF\n330 COLOR 4:LINE(40,155)-(65,145),4,BF:PRINT:PRINT \"SCENE 2: MAJESTIC MOUNTAIN TRAIL\":RETURN\n400 REM --- SCENE 3: DEEP FOREST PATHWAY ---\n410 SCREEN 1:CLS:COLOR 6:LINE(0,120)-(319,199),6,BF:COLOR 2\n420 FOR X=20 TO 300 STEP 40:LINE(X,120)-(X+10,70),8,BF:CIRCLE(X+5,65),15:NEXT X\n430 PRINT:PRINT \"SCENE 3: DEEP FOREST PATHWAY\":RETURN\n500 REM --- SCENE 4: DESERT CACTUS SUNSET ---\n510 SCREEN 1:CLS:COLOR 4:CIRCLE(160,110),35:COLOR 14:FOR Y=115 TO 140 STEP 5:LINE(0,Y)-(319,Y):NEXT Y\n520 COLOR 6:LINE(0,140)-(319,199),6,BF:COLOR 2:LINE(60,100)-(60,140):LINE(50,115)-(60,115)\n530 LINE(240,90)-(240,140):LINE(240,110)-(250,110):PRINT:PRINT \"SCENE 4: DESERT CACTUS SUNSET\":RETURN\n600 REM --- SCENE 5: CALM OCEAN HORIZON ---\n610 SCREEN 1:CLS:COLOR 14:CIRCLE(160,100),20:COLOR 1:LINE(0,100)-(319,199),1,BF\n620 PRINT:PRINT \"SCENE 5: CALM OCEAN HORIZON\":RETURN\n700 REM --- SCENE 6: REMOTE TROPICAL ISLAND ---\n710 SCREEN 1:CLS:COLOR 1:LINE(0,120)-(319,199),1,BF:COLOR 14:CIRCLE(160,140),40\n720 COLOR 8:LINE(150,120)-(160,80):COLOR 2:CIRCLE(160,80),10:PRINT:PRINT \"SCENE 6: REMOTE TROPICAL ISLAND\":RETURN\n800 REM --- SCENE 7: STARRY NIGHT CRESCENT ---\n810 SCREEN 1:CLS:COLOR 15:FOR I=1 TO 50:PSET(INT(RND(1)*320),INT(RND(1)*140)):NEXT I\n820 CIRCLE(240,40),15:COLOR 0:CIRCLE(235,40),15:COLOR 8:LINE(0,140)-(319,199),8,BF\n830 PRINT:PRINT \"SCENE 7: STARRY NIGHT CRESCENT\":RETURN\n900 REM --- SCENE 8: DEEP CANYON RIDGE ---\n910 SCREEN 1:CLS:COLOR 14:LINE(0,130)-(319,199),14,BF:COLOR 8\n920 LINE(0,100)-(80,140):LINE(0,100)-(0,199):LINE(319,90)-(240,130):LINE(319,90)-(319,199)\n930 PRINT:PRINT \"SCENE 8: DEEP CANYON RIDGE\":RETURN\n1000 REM --- SCENE 9: WINDING RIVER VALLEY ---\n1010 SCREEN 1:CLS:COLOR 2:LINE(0,110)-(319,199),2,BF:COLOR 1\n1020 LINE(160,110)-(40,199):LINE(165,110)-(280,199)\n1030 PRINT:PRINT \"SCENE 9: WINDING RIVER VALLEY\":RETURN\n1100 REM --- SCENE 10: RURAL COUNTRY WINDMILL ---\n1105 SCREEN 1:CLS:COLOR 2:LINE(0,130)-(319,199),2,BF:COLOR 8:LINE(155,130)-(165,130)\n1110 LINE(155,130)-(150,80):LINE(165,130)-(170,80):COLOR 15\n1120 LINE(160,75)-(140,65):LINE(160,75)-(180,85):LINE(160,75)-(150,95):LINE(160,75)-(170,55)\n1130 PRINT:PRINT \"SCENE 10: RURAL COUNTRY WINDMILL\":RETURN\n1200 REM --- SCENE 11: ANCIENT MEGALITH STONES ---\n1210 SCREEN 1:CLS:COLOR 2:LINE(0,140)-(319,199),2,BF:COLOR 8\n1220 LINE(60,140)-(80,90),8,BF:LINE(100,140)-(120,90),8,BF:LINE(50,90)-(130,75),8,BF\n1230 PRINT:PRINT \"SCENE 11: ANCIENT MEGALITH STONES\":RETURN\n1300 REM --- SCENE 12: COZY CABIN IN WINTER ---\n1310 SCREEN 1:CLS:COLOR 15:LINE(0,120)-(319,199),15,BF:COLOR 6:LINE(120,120)-(180,160),6,BF\n1320 COLOR 4:LINE(110,120)-(150,90):LINE(150,90)-(190,120):LINE(190,120)-(110,120)\n1330 PRINT:PRINT \"SCENE 12: COZY CABIN IN WINTER\":RETURN\n1400 REM --- SCENE 13: AUTUMN HARVEST FIELDS ---\n1410 SCREEN 1:CLS:COLOR 14:LINE(0,110)-(319,199),14,BF:COLOR 6\n1420 FOR X=10 TO 310 STEP 20:LINE(X,110)-(X,150):NEXT X\n1430 PRINT:PRINT \"SCENE 13: AUTUMN HARVEST FIELDS\":RETURN\n1500 REM --- SCENE 14: CLIFFSIDE WATERFALL ---\n1510 SCREEN 1:CLS:COLOR 8:LINE(0,80)-(100,199),8,BF:LINE(220,80)-(319,199),8,BF\n1520 COLOR 11:LINE(105,80)-(215,199),11,BF\n1530 PRINT:PRINT \"SCENE 14: MOUNTAIN CLIFFSIDE WATERFALL\":RETURN\n1600 REM --- SCENE 15: ARCHED STONE BRIDGE ---\n1610 SCREEN 1:CLS:COLOR 1:LINE(0,130)-(319,199),1,BF:COLOR 8\n1620 LINE(40,130)-(280,110),8,BF:COLOR 1:CIRCLE(90,130),20:CIRCLE(160,130),20:CIRCLE(230,130),20\n1630 PRINT:PRINT \"SCENE 15: ARCHED STONE SEASIDE BRIDGE\":RETURN",
  "SLIDESHOW": "10 REM 80-COLUMN WIDESCREEN GIANT GALLERY\n20 DIM S$(15,16):CLS:SC = 1\n30 REM --- SCENE 1: SERENE LAKE ---\n40 S$(1,1) = \"           _                                                            \"\n50 S$(1,2) = \"          ( )  _                                                        \"\n60 S$(1,3) = \"         (   )( )                                                       \"\n70 S$(1,4) = \"        (________)                    _ _                               \"\n80 S$(1,5) = \"                                     (   )                              \"\n90 S$(1,6) = \"                       _            (_____)                             \"\n100 S$(1,7) = \"       _/\\_           ( )                                               \"\n110 S$(1,8) = \"      /    \\         (___)                                              \"\n120 S$(1,14) = \" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ \"\n130 S$(1,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~   PEACEFUL LAKEFRONT SUNRISE   ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n140 S$(1,16) = \" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ \"\n150 REM --- SCENE 2: MAJESTIC MOUNTAINS ---\n160 S$(2,1) = \"                _/\\_                                                    \"\n170 S$(2,2) = \"               /    \\                _/\\_                               \"\n180 S$(2,5) = \"            /          \\          /        \\            _/\\_            \"\n190 S$(2,7) = \"          /              \\______/            \\________/      \\__________\"\n200 S$(2,11) = \"   ||      Oo_o_P                                                        \"\n210 S$(2,12) = \" __||_____/______\\______________________________________________________\"\n220 S$(2,14) = \" ---------------------------------------------------------------------- \"\n230 S$(2,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~    EXPANSIVE MOUNTAIN TRAIL    ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n240 S$(2,16) = \" ---------------------------------------------------------------------- \"\n250 REM --- SCENE 3: FOREST TRAILS ---\n260 S$(3,1) = \"       Y      Y            Y      Y            Y      Y            Y    \"\n270 S$(3,2) = \"      / \\    / \\          / \\    / \\          / \\    / \\          / \\   \"\n280 S$(3,4) = \"    /_____\\/_____\\      /_____\\/_____\\      /_____\\/_____\\      /_____\\ \"\n290 S$(3,6) = \" _____||______||__________||______||__________||______||__________||____\"\n300 S$(3,14) = \" ###################################################################### \"\n310 S$(3,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~     DEEP FOREST PATHWAY        ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n320 S$(3,16) = \" ###################################################################### \"\n330 REM --- SCENE 4: DESERT OASIS ---\n340 S$(4,2) = \"         _  _             .  .  .               _  _                     \"\n350 S$(4,4) = \"       _(_)(_)_           \\ | /              _(_)(_)_                   \"\n360 S$(4,6) = \"      (_,______)        --- O ---           (_,______)                  \"\n370 S$(4,8) = \"         ||               / | \\                ||                       \"\n380 S$(4,10) = \"      \\  ||  /             '  '  '          \\  ||  /                    \"\n390 S$(4,12) = \" ______\\_||_/________________________________\\_||_/_____________________\"\n400 S$(4,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~       DESERT OASIS SUN         ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n410 REM --- SCENE 5: OCEAN HORIZON ---\n420 S$(5,3) = \"                       .  .  .  .  .                                    \"\n430 S$(5,5) = \"                     .               .                                  \"\n440 S$(5,7) = \"                    .                 .                                 \"\n450 S$(5,9) = \"   _________________  _______________  _______________________________ \"\n460 S$(5,11) = \"  (                 )(               )(                                )\"\n470 S$(5,13) = \" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ \"\n480 S$(5,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~      CALM OCEAN HORIZON        ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n490 REM --- SCENE 6: TROPICAL ISLAND ---\n500 S$(6,2) = \"          \\ /                                                           \"\n510 S$(6,4) = \"        - - * - -                                                       \"\n520 S$(6,6) = \"          / \\                                    /|                     \"\n530 S$(6,8) = \"                                               _/_|_                    \"\n540 S$(6,10) = \"                     .----.                    \\___/                    \"\n550 S$(6,12) = \"   _________________(      )___________________________________________ \"\n560 S$(6,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~     REMOTE TROPICAL ISLAND     ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n570 REM --- SCENE 7: NIGHT SKY ---\n580 S$(7,2) = \"     *                 *                   *                 *          \"\n590 S$(7,4) = \"            *                  )                  *                  *  \"\n600 S$(7,6) = \"    *                 *       (   )            *                 *      \"\n610 S$(7,8) = \"           *                 (_____)                  *                 \"\n620 S$(7,12) = \" _______________________________________________________________________\"\n630 S$(7,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~     STARRY NIGHT CRESCENT      ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n640 REM --- SCENE 8: CANYON RIDGE ---\n650 S$(8,2) = \"   |                                                                |   \"\n660 S$(8,4) = \"   |______                                                    ______|   \"\n670 S$(8,6) = \"   |      \\______                                      ______/      |   \"\n680 S$(8,8) = \"   |             \\______                        ______/             |   \"\n690 S$(8,12) = \" __|____________________\\______________________/____________________|___\"\n700 S$(8,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~       DEEP CANYON RIDGE        ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n710 REM --- SCENE 9: RIVER VALLEYS ---\n720 S$(9,2) = \"       _/\\_                                              _/\\_           \"\n730 S$(9,4) = \"      /    \\                                            /    \\          \"\n740 S$(9,6) = \"     /      \\                  \\    /                  /      \\         \"\n750 S$(9,8) = \"    /        \\                  \\  /                  /        \\        \"\n760 S$(9,12) = \" __/__________\\__________________\\/__________________/__________\\_______\"\n770 S$(9,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~      WINDING RIVER VALLEY      ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n780 REM --- SCENE 10: RURAL WINDMILL ---\n790 S$(10,2) = \"                                 \\ /                                    \"\n800 S$(10,4) = \"                               - - * - -                                \"\n810 S$(10,6) = \"                                 / \\                                    \"\n820 S$(10,8) = \"                                |   |                                   \"\n830 S$(10,12) = \" _______________________________|___|___________________________________\"\n840 S$(10,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~     RURAL COUNTRY WINDMILL     ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n850 REM --- SCENE 11: STONEHENGE ---\n860 S$(11,4) = \"             ______          ______          ______                     \"\n870 S$(11,6) = \"            |      |        |      |        |      |                    \"\n880 S$(11,8) = \"            |      |        |      |        |      |                    \"\n890 S$(11,12) = \" ___________|______|________|______|________|______|____________________\"\n900 S$(11,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~    ANCIENT MEGALITH STONES     ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n910 REM --- SCENE 12: WINTER CABIN ---\n920 S$(12,3) = \"                               (  )                                     \"\n930 S$(12,5) = \"                             ___||___                                   \"\n940 S$(12,7) = \"                            /        \\                                  \"\n950 S$(12,9) = \"                            |  []  []|                                  \"\n960 S$(12,12) = \" ***************************|********|**********************************\"\n970 S$(12,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~       COZY WINTER CABIN        ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n980 REM --- SCENE 13: CORN FIELDS ---\n990 S$(13,4) = \"      ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||  ||    \"\n1000 S$(13,6) = \"      \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/  \\/    \"\n1010 S$(13,8) = \"      ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##  ##    \"\n1020 S$(13,12) = \" _____||__||__||__||__||__||__||__||__||__||__||__||__||__||__||__||____\"\n1030 S$(13,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~     AUTUMN HARVEST FIELDS      ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n1040 REM --- SCENE 14: WATERFALLS ---\n1050 S$(14,3) = \"      ___________                                 ___________           \"\n1060 S$(14,5) = \"     |           |        |  |  |  |  |          |           |          \"\n1070 S$(14,7) = \"     |           |        |  |  |  |  |          |           |          \"\n1080 S$(14,9) = \"     |           |        |  |  |  |  |          |           |          \"\n1090 S$(14,12) = \" ____|___________|________|__|__|__|__|__________|___________|__________\"\n1100 S$(14,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~     MOUNTAIN CLIFTSIDE WATERFALL   ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n1110 REM --- SCENE 15: OLD BRIDGES ---\n1120 S$(15,4) = \"          _________________________________________________             \"\n1130 S$(15,6) = \"         /     \\     /     \\     /     \\     /     \\     \\            \"\n1140 S$(15,8) = \"        /       \\   /       \\   /       \\   /       \\   /           \"\n1150 S$(15,12) = \" ______/_________\\_/_________\\_/_________\\_/_________\\_/________________\"\n1160 S$(15,15) = \"   ~ ~ ~ ~ ~ ~ ~ ~     ARCHED STONE SEASIDE BRIDGE    ~ ~ ~ ~ ~ ~ ~ ~ ~ \"\n1170 REM ==== MAIN SLIDESHOW CONTROLLER ====\n1180 CLS:FOR L = 1 TO 6:PRINT:NEXT L\n1190 FOR R = 1 TO 16\n1200 A$ = S$(SC, R):IF A$ = \"\" THEN A$ = \" \"\n1210 PRINT TAB(4); A$\n1220 NEXT R\n1230 REM CALIBRATED SLOW SLIDE REFRESH LOOP (APPROX 10 SECONDS)\n1240 FOR D = 1 TO 66000:NEXT D\n1250 SC = SC + 1:IF SC > 15 THEN SC = 1\n1260 GOTO 1180",
  "CLOCK12-B1": "10 REM PRISTINE RETRO BLOCK CLOCK\n20 DIM D$(9,3):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 3:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT CHR$(147);\"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM MAIN INTERACTIVE LOOP\n90 PRINT CHR$(147);:FOR L=1 TO 8:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 3\n120 PRINT TAB(4);D$(H1,R);SP$;D$(H2,R);\n130 IF R=1 OR R=3 THEN PRINT \"   \";\n140 IF R=2 THEN PRINT \" : \";\n150 PRINT D$(M1,R);SP$;D$(M2,R);\n160 IF R=1 OR R=3 THEN PRINT \"   \";\n170 IF R=2 THEN PRINT \" : \";\n180 PRINT D$(S1,R);SP$;D$(S2,R):PRINT\n190 NEXT R\n200 FOR D=1 TO 950:NEXT D\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXX\",\"X X\",\"XXX\", \" X \",\" X \",\" X \", \"XXX\",\"  X\",\"XXX\", \"XXX\",\"  X\",\"XXX\"\n1010 DATA \"X X\",\"XXX\",\"  X\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"  X\",\"  X\"\n1020 DATA \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"  X\"",
  "CLOCK4": "10 REM LARGE BLOCK CLOCK FOR C64\n20 PRINT CHR$(147):DIM N(9,2):BL$=CHR$(160):SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=0 TO 2:READ N(X,Y):NEXT Y:NEXT X\n40 PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 PRINT CHR$(147)\n90 FOR R=0 TO 2:FOR L=1 TO 8:PRINT:NEXT L:PRINT TAB(5);\n100 H1=INT(HR/10):H2=HR-H1*10:M1=INT(MN/10):M2=MN-M1*10\n110 S1=INT(SC/10):S2=SC-S1*10\n120 GOSUB 500:G=H1:GOSUB 400:G=H2:GOSUB 400:GOSUB 510\n130 G=M1:GOSUB 400:G=M2:GOSUB 400:GOSUB 510\n140 G=S1:GOSUB 400:G=S2:GOSUB 400:PRINT:NEXT R\n150 FOR D=1 TO 650:NEXT D\n160 SC=SC+1:IF SC<60 THEN GOTO 80\n170 SC=0:MN=MN+1:IF MN<60 THEN GOTO 80\n180 MN=0:HR=HR+1:IF HR<24 THEN GOTO 80\n190 HR=0:GOTO 80\n400 REM DRAW DIGIT ROW R\n410 V=N(G,R):FOR B=1 TO 3\n420 IF V>=4 THEN PRINT BL$;:V=V-4:GOTO 440\n430 PRINT SP$;\n440 NEXT B:PRINT SP$;:RETURN\n500 REM DRAW COLON ROW R\n510 IF R<>1 THEN PRINT \"   \";:RETURN\n520 PRINT \" \"BL$\" \";:RETURN\n1000 DATA 7,5,7, 2,2,2, 7,2,7, 7,2,7, 5,7,2\n1010 DATA 7,7,7, 7,7,7, 7,2,2, 7,7,7, 7,7,2",
  "HUNT": "10 REM ==== STARBASE NUMBER HUNT ====\n20 PRINT \"STARBASE NUMBER HUNT\"\n30 PRINT \"GUESS THE SECRET NUMBER (1-100) IN AS FEW TRIES AS POSSIBLE.\"\n40 PRINT \"\"\n50 DIM SCORES(3)\n60 FOR ROUND = 1 TO 3\n70 T = INT(RND(1) * 100) + 1\n80 G = 0\n90 PRINT \"--- ROUND \"; ROUND; \" ---\"\n100 GOSUB 500\n110 SCORES(ROUND) = G\n120 NEXT ROUND\n130 PRINT \"\"\n140 PRINT \"FINAL RESULTS:\"\n150 TOTAL = 0\n160 FOR ROUND = 1 TO 3\n170 PRINT \"ROUND \"; ROUND; \": \"; SCORES(ROUND); \" GUESSES\"\n180 TOTAL = TOTAL + SCORES(ROUND)\n190 NEXT ROUND\n200 AVG = INT(TOTAL / 3 * 100 + 0.5) / 100\n210 PRINT \"AVERAGE GUESSES: \"; AVG\n220 IF AVG <= 5 THEN PRINT \"RANK: ACE NAVIGATOR\"\n230 IF AVG > 5 AND AVG <= 8 THEN PRINT \"RANK: SOLID PILOT\"\n240 IF AVG > 8 THEN PRINT \"RANK: KEEP PRACTICING, CADET\"\n250 END\n500 REM --- GUESS LOOP SUBROUTINE ---\n510 INPUT \"YOUR GUESS\"; GS\n520 G = G + 1\n530 IF GS = T THEN GOTO 570\n540 IF GS < T THEN PRINT \"TOO LOW\"\n550 IF GS > T THEN PRINT \"TOO HIGH\"\n560 GOTO 510\n570 PRINT \"CORRECT! IT TOOK YOU \"; G; \" GUESSES.\"\n580 RETURN",
  "SYSMON-GEMINI": "10 REM ==== MACBASIC ULTIMATE SYSTEM MONITOR ====\n20 SCREEN 1:CLS\n30 CPU = 40:MEM = 55:DISK = 70:NET = 20\n70 DIM CPUHIST(40)\n80 FOR I = 0 TO 39:CPUHIST(I) = 40:NEXT I\n110 UPTIME = 0\n200 REM ==== MAIN REFRESH LOOP ====\n210 CPU = CPU + (RND(1) - 0.5) * 18\n220 IF CPU < 3 THEN CPU = 3\n230 IF CPU > 97 THEN CPU = 97\n240 MEM = MEM + (RND(1) - 0.5) * 6\n250 IF MEM < 10 THEN MEM = 10\n260 IF MEM > 95 THEN MEM = 95\n270 DISK = DISK + (RND(1) - 0.5) * 2\n280 IF DISK < 0 THEN DISK = 0\n290 IF DISK > 99 THEN DISK = 99\n300 NET = NET + (RND(1) - 0.5) * 30\n310 IF NET < 0 THEN NET = 0\n320 IF NET > 100 THEN NET = 100\n330 UPTIME = UPTIME + 1\n340 FOR I = 0 TO 38:CPUHIST(I) = CPUHIST(I + 1):NEXT I\n370 CPUHIST(39) = CPU\n400 CLS:COLOR 7\n410 PRINT \"MACBASIC SYSTEM MONITOR   UPTIME: \"; UPTIME; \"S\"\n420 PRINT \"----------------------------------------\"\n430 PRINT \"CPU  \"; INT(CPU); \"%\"\n440 PRINT \"MEM  \"; INT(MEM); \"%\"\n450 PRINT \"DISK \"; INT(DISK); \"%\"\n460 PRINT \"NET  \"; INT(NET); \"%\"\n470 PRINT \"(PRESS CTRL+C TO STOP MONITORING)\"\n500 REM --- DRAW THE GAUGES ---\n510 COLOR 7\n520 LINE (10,85)-(310,97),7,B\n530 LINE (10,105)-(310,117),7,B\n540 LINE (10,125)-(310,137),7,B\n550 LINE (10,145)-(310,157),7,B\n560 W = 10 + (CPU / 100) * 300:LINE (10,85)-(W,97),10,BF\n580 W = 10 + (MEM / 100) * 300:LINE (10,105)-(W,117),11,BF\n600 W = 10 + (DISK / 100) * 300:LINE (10,125)-(W,137),14,BF\n620 W = 10 + (NET / 100) * 300:LINE (10,145)-(W,157),12,BF\n700 REM --- DRAW CPU HISTORY GRAPH ---\n710 LINE (10,165)-(310,195),7,B\n720 FOR I = 0 TO 38\n730 X1 = 10 + I * 7.5\n740 Y1 = 195 - (CPUHIST(I) / 100) * 28\n750 X2 = 10 + (I + 1) * 7.5\n760 Y2 = 195 - (CPUHIST(I + 1) / 100) * 28\n770 LINE (X1,Y1)-(X2,Y2),10\n780 NEXT I\n900 REM --- EMULATOR SAFE STABLE TIME REFRESH ---\n910 FOR D = 1 TO 12000:NEXT D\n920 GOTO 200",
  "CLOCK9": "10 REM UNIVERSAL STRINGS BLOCK CLOCK\n20 PRINT CHR$(147):DIM D$(9,2):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=0 TO 2:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM SETUP DISPLAY ROW\n90 PRINT CHR$(147);:FOR L=1 TO 10:PRINT:NEXT L:PRINT TAB(4);\n100 FOR R=0 TO 2\n110 H1=INT(HR/10):H2=HR-H1*10:M1=INT(MN/10):M2=MN-M1*10\n115 S1=INT(SC/10):S2=SC-S1*10\n120 S$=D$(H1,R)+SP$+D$(H2,R)+SP$\n130 S$=S$+D$(M1,R)+SP$+D$(M2,R)+SP$\n140 S$=S$+D$(S1,R)+SP$+D$(S2,R)\n150 FOR B=1 TO LEN(S$):C$=MID$(S$,B,1)\n160 IF C$=\"#\" THEN PRINT BL$;\n170 IF C$=\".\" THEN PRINT SP$;\n180 NEXT B:PRINT TAB(4);:NEXT R\n190 FOR D=1 TO 900:NEXT D\n200 SC=SC+1:IF SC<60 THEN GOTO 90\n210 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n220 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n230 HR=0:GOTO 90\n1000 DATA ###,#.#,###, .#.,.#.,.#., ###,..#,###, ###,..#,###, #.#,###,..#\n1010 DATA ###,###,###, ###,###,###, ###,..#,..#, ###,###,###, ###,###,..#",
  "CLOCK2": "10 REM COMMODORE 64 DIGITAL CLOCK\n20 PRINT CHR$(147)\n30 PRINT \"ENTER STARTING TIME:\"\n40 INPUT \"HOURS (0-23) \";HR\n50 INPUT \"MINUTES (0-59) \";MN\n60 INPUT \"SECONDS (0-59) \";SC\n70 PRINT CHR$(147)\n80 FOR L = 1 TO 12: PRINT : NEXT L : PRINT TAB(12);\n100 IF HR < 10 THEN PRINT \"0\";\n110 PRINT HR;\":\";\n120 IF MN < 10 THEN PRINT \"0\";\n130 PRINT MN;\":\";\n140 IF SC < 10 THEN PRINT \"0\";\n150 PRINT SC\n170 FOR D = 1 TO 850: NEXT D\n190 SC = SC + 1\n200 IF SC < 60 THEN GOTO 70\n210 SC = 0: MN = MN + 1\n220 IF MN < 60 THEN GOTO 70\n230 MN = 0: HR = HR + 1\n240 IF HR < 24 THEN GOTO 70\n250 HR = 0: GOTO 70",
  "SYSMON": "10 REM ==== MACBASIC SYSTEM MONITOR ====\n20 SCREEN 1\n30 CPU = 40\n40 MEM = 55\n50 DISK = 70\n60 NET = 20\n70 DIM CPUHIST(39)\n80 FOR I = 0 TO 39\n90 CPUHIST(I) = 40\n100 NEXT I\n110 UPTIME = 0\n200 REM ==== MAIN REFRESH LOOP ====\n210 CPU = CPU + (RND(1) - 0.5) * 18\n220 IF CPU < 3 THEN CPU = 3\n230 IF CPU > 97 THEN CPU = 97\n240 MEM = MEM + (RND(1) - 0.5) * 6\n250 IF MEM < 10 THEN MEM = 10\n260 IF MEM > 95 THEN MEM = 95\n270 DISK = DISK + (RND(1) - 0.5) * 2\n280 IF DISK < 0 THEN DISK = 0\n290 IF DISK > 99 THEN DISK = 99\n300 NET = NET + (RND(1) - 0.5) * 30\n310 IF NET < 0 THEN NET = 0\n320 IF NET > 100 THEN NET = 100\n330 UPTIME = UPTIME + 1\n340 FOR I = 0 TO 38\n350 CPUHIST(I) = CPUHIST(I + 1)\n360 NEXT I\n370 CPUHIST(39) = CPU\n400 CLS\n410 PRINT \"MACBASIC SYSTEM MONITOR    UPTIME: \"; UPTIME; \"S\"\n420 PRINT \"----------------------------------------\"\n430 PRINT \"CPU  \"; INT(CPU); \"%\"\n440 PRINT \"MEM  \"; INT(MEM); \"%\"\n450 PRINT \"DISK \"; INT(DISK); \"%\"\n460 PRINT \"NET  \"; INT(NET); \"%\"\n470 PRINT \"(PRESS CTRL+C TO STOP MONITORING)\"\n500 REM --- DRAW GAUGES ---\n510 COLOR 7\n520 LINE (10,85)-(310,97),7,B\n530 LINE (10,105)-(310,117),7,B\n540 LINE (10,125)-(310,137),7,B\n550 LINE (10,145)-(310,157),7,B\n560 W = 10 + (CPU / 100) * 300\n570 LINE (10,85)-(W,97),10,BF\n580 W = 10 + (MEM / 100) * 300\n590 LINE (10,105)-(W,117),11,BF\n600 W = 10 + (DISK / 100) * 300\n610 LINE (10,125)-(W,137),14,BF\n620 W = 10 + (NET / 100) * 300\n630 LINE (10,145)-(W,157),12,BF\n700 REM --- DRAW CPU HISTORY GRAPH ---\n710 LINE (10,165)-(310,195),7,B\n720 FOR I = 0 TO 38\n730 X1 = 10 + I * 7.5\n740 Y1 = 195 - (CPUHIST(I) / 100) * 28\n750 X2 = 10 + (I + 1) * 7.5\n760 Y2 = 195 - (CPUHIST(I + 1) / 100) * 28\n770 LINE (X1,Y1)-(X2,Y2),10\n780 NEXT I\n900 SLEEP 0.4\n910 GOTO 200",
  "CLOCK-FINAL-B3": "10 REM FINAL SOLID RETRO BLOCK CLOCK\n20 DIM D$(9,3):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 3:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 CLS:PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM MAIN INTERACTIVE LOOP\n90 CLS:FOR L=1 TO 8:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 3\n120 L$ = D$(H1,R) + SP$ + D$(H2,R)\n130 IF R=2 THEN L$ = L$ + \" : \"\n140 IF R<>2 THEN L$ = L$ + \"   \"\n150 L$ = L$ + D$(M1,R) + SP$ + D$(M2,R)\n160 IF R=2 THEN L$ = L$ + \" : \"\n170 IF R<>2 THEN L$ = L$ + \"   \"\n180 PRINT TAB(4); L$ + D$(S1,R) + SP$ + D$(S2,R)\n190 NEXT R\n200 FOR D=1 TO 950:NEXT D\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXX\",\"X X\",\"XXX\", \" X \",\" X \",\" X \", \"XXX\",\"  X\",\"XXX\", \"XXX\",\"  X\",\"XXX\"\n1010 DATA \"X X\",\"XXX\",\"  X\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"  X\",\"  X\"\n1020 DATA \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"  X\"",
  "BASIC-CLOCK-B2": "10 REM FINAL SOLID RETRO BLOCK CLOCK\n20 DIM D$(9,3):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 3:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT CHR$(147);\"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM MAIN INTERACTIVE LOOP\n90 PRINT CHR$(147);:FOR L=1 TO 8:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 3\n120 L$ = D$(H1,R) + SP$ + D$(H2,R)\n130 IF R=2 THEN L$ = L$ + \" : \"\n140 IF R<>2 THEN L$ = L$ + \"   \"\n150 L$ = L$ + D$(M1,R) + SP$ + D$(M2,R)\n160 IF R=2 THEN L$ = L$ + \" : \"\n170 IF R<>2 THEN L$ = L$ + \"   \"\n180 PRINT TAB(4); L$ + D$(S1,R) + SP$ + D$(S2,R)\n190 NEXT R\n200 FOR D=1 TO 950:NEXT D\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXX\",\"X X\",\"XXX\", \" X \",\" X \",\" X \", \"XXX\",\"  X\",\"XXX\", \"XXX\",\"  X\",\"XXX\"\n1010 DATA \"X X\",\"XXX\",\"  X\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"  X\",\"  X\"\n1020 DATA \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"  X\"",
  "PICTURE_BG": "10 REM ==== RETRO POSTCARD ====\n20 SCREEN 1\n30 REM STARFIELD\n40 COLOR 15\n50 FOR I = 1 TO 60\n60 SX = INT(RND(1) * 320)\n70 SY = INT(RND(1) * 120)\n80 PSET (SX,SY)\n90 NEXT I\n100 REM SUN\n110 COLOR 14\n120 CIRCLE (270,40),25\n130 REM GROUND\n140 COLOR 2\n150 LINE (0,150)-(319,199),2,BF\n160 REM MOUNTAIN\n170 COLOR 8\n180 LINE (0,150)-(80,100)\n190 LINE (80,100)-(160,150)\n200 REM HOUSE WALLS\n210 COLOR 4\n220 LINE (110,110)-(170,150),4,BF\n230 REM ROOF\n240 COLOR 6\n250 LINE (100,110)-(140,80)\n260 LINE (140,80)-(180,110)\n270 LINE (180,110)-(100,110)\n280 REM DOOR\n290 COLOR 0\n300 LINE (135,150)-(150,125),0,BF\n310 PRINT \"A QUIET EVENING ON THE FRONTIER.\"",
  "CLOCK5": "10 REM LARGE BLOCK CLOCK FOR C64\n20 PRINT CHR$(147):DIM N(9,2):BL$=CHR$(160):SP$=\" \"\n30 RESTORE:FOR X=0 TO 9:FOR Y=0 TO 2:READ N(X,Y):NEXT Y:NEXT X\n40 PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 PRINT CHR$(147)\n90 FOR R=0 TO 2:FOR L=1 TO 8:PRINT:NEXT L:PRINT TAB(5);\n100 H1=INT(HR/10):H2=HR-H1*10:M1=INT(MN/10):M2=MN-M1*10\n110 S1=INT(SC/10):S2=SC-S1*10\n120 GOSUB 500:G=H1:GOSUB 400:G=H2:GOSUB 400:GOSUB 510\n130 G=M1:GOSUB 400:G=M2:GOSUB 400:GOSUB 510\n140 G=S1:GOSUB 400:G=S2:GOSUB 400:PRINT:NEXT R\n150 FOR D=1 TO 650:NEXT D\n160 SC=SC+1:IF SC<60 THEN GOTO 80\n170 SC=0:MN=MN+1:IF MN<60 THEN GOTO 80\n180 MN=0:HR=HR+1:IF HR<24 THEN GOTO 80\n190 HR=0:GOTO 80\n400 REM DRAW DIGIT ROW R\n410 V=N(G,R):FOR B=1 TO 3\n420 IF V>=4 THEN PRINT BL$;:V=V-4:GOTO 440\n430 PRINT SP$;\n440 NEXT B:PRINT SP$;:RETURN\n500 REM DRAW COLON ROW R\n510 IF R<>1 THEN PRINT \"   \";:RETURN\n520 PRINT \" \"BL$\" \";:RETURN\n1000 DATA 7,5,7,2,2,2,7,2,7,7,2,7,5,7,2,7,7,7,7,7,7,7,2,2,7,7,7,7,7,2",
  "SYSMON-GEMINI-ADV": "10 REM ==== MACBASIC ADVANCED HARDWARE ENGINE ====\n20 SCREEN 1:CLS\n30 TEMP = 42:VOLT = 1.21:CCHE = 94:BGP = 8\n70 DIM TMPHIST(40)\n80 FOR I = 0 TO 39:TMPHIST(I) = 42:NEXT I\n110 UPTIME = 0\n200 REM ==== ADVANCED METRICS SIMULATION ====\n210 TEMP = TEMP + (RND(1) - 0.5) * 4\n220 IF TEMP < 35 THEN TEMP = 35\n230 IF TEMP > 82 THEN TEMP = 82\n240 VOLT = VOLT + (RND(1) - 0.5) * 0.05\n250 IF VOLT < 1.15 THEN VOLT = 1.15\n260 IF VOLT > 1.35 THEN VOLT = 1.35\n270 CCHE = CCHE + (RND(1) - 0.5) * 1.5\n280 IF CCHE < 85 THEN CCHE = 85\n290 IF CCHE > 99 THEN CCHE = 99\n300 BGP = BGP + INT((RND(1) - 0.4) * 5)\n310 IF BGP < 0 THEN BGP = 0\n320 IF BGP > 45 THEN BGP = 45\n330 UPTIME = UPTIME + 1\n340 FOR I = 0 TO 38:TMPHIST(I) = TMPHIST(I + 1):NEXT I\n370 TMPHIST(39) = TEMP\n400 CLS:COLOR 7\n410 PRINT \"MACBASIC KERNEL CORE DIAGNOSTICS   UP: \"; UPTIME; \"S\"\n420 PRINT \"----------------------------------------\"\n430 PRINT \"NVMe THERMALS : \"; INT(TEMP); \" C\"\n440 PRINT \"V-CORE VOLTAGE: \"; INT(VOLT * 100) / 100; \" V\"\n450 PRINT \"L3 CACHE HIT  : \"; INT(CCHE); \" %\"\n460 PRINT \"BGP LINK FLAPS: \"; INT(BGP); \" PKTS\"\n470 PRINT \"(PRESS CTRL+C TO INTERRUPT CORE)\"\n500 REM --- DRAW VIBRANT SYSTEM GAUGES ---\n520 LINE (10,85)-(310,97),7,B\n530 LINE (10,105)-(310,117),7,B\n540 LINE (10,125)-(310,137),7,B\n550 LINE (10,145)-(310,157),7,B\n560 W = 10 + ((TEMP - 35) / 47) * 300:LINE (10,85)-(W,97),12,BF:REM RED TEMP\n580 W = 10 + ((VOLT - 1.15) / 0.2) * 300:LINE (10,105)-(W,117),14,BF:REM YELLOW VOLT\n600 W = 10 + ((CCHE - 85) / 14) * 300:LINE (10,125)-(W,137),10,BF:REM GREEN CACHE\n620 W = 10 + (BGP / 45) * 300:LINE (10,145)-(W,157),11,BF:REM CYAN BGP\n700 REM --- DRAW NVMe THERMAL CHRONO-GRAPH ---\n710 LINE (10,165)-(310,195),7,B\n720 FOR I = 0 TO 38\n730 X1 = 10 + I * 7.5\n740 Y1 = 195 - ((TMPHIST(I) - 35) / 47) * 28\n750 X2 = 10 + (I + 1) * 7.5\n760 Y2 = 195 - ((TMPHIST(I + 1) - 35) / 47) * 28\n770 LINE (X1,Y1)-(X2,Y2),12\n780 NEXT I\n900 FOR D = 1 TO 12000:NEXT D\n920 GOTO 200",
  "MATRIXSENEW": "10 REM ULTIMATE SLEEP-SYNCHRONIZED MATRIX\n20 DIM C(80),ST(80)\n30 CLS:REM INITIALIZE ALL 80 HORIZONTAL COLUMNS\n40 FOR I = 1 TO 80\n50 ST(I) = INT(RND(1) * 2):REM 1 = RAINING, 0 = EMPTY\n60 C(I) = INT(RND(1) * 15) + 5:REM LENGTH OF STREAM\n70 NEXT I\n80 REM MAIN ANIMATION SCROLL LOOP\n90 FOR X = 1 TO 80\n100 REM UPDATE STREAM LIFESPAN\n110 C(X) = C(X) - 1\n120 IF C(X) <= 0 THEN ST(X) = INT(RND(1) * 2):C(X) = INT(RND(1) * 15) + 5\n130 REM CHOOSE CHARACTER AND PRINT INDIVIDUALLY\n140 IF ST(X) = 0 THEN PRINT \" \";:GOTO 180\n150 IF C(X) = 1 THEN PRINT CHR$(INT(RND(1) * 26) + 65);:GOTO 180\n160 PRINT CHR$(INT(RND(1) * 26) + 97);\n180 NEXT X\n190 REM CARRIAGE RETURN AT COLUMN 80 TRIGGERS SMOOTH SCROLL\n200 PRINT\n210 REM HARDWARE SLEEP FRACTION FOR ACCURATE FLUIDITY\n220 SLEEP 0.05\n230 GOTO 80",
  "CLOCK-FINAL-B5": "10 REM JUMBO 5X4 BLOCK CLOCK\n20 DIM D$(9,5):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 5:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 CLS:PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM DISPLAY LOOP\n90 CLS:FOR L=1 TO 6:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 5\n120 L$ = D$(H1,R) + SP$ + D$(H2,R)\n130 IF R=2 OR R=4 THEN L$ = L$ + \" : \"\n140 IF R<>2 AND R<>4 THEN L$ = L$ + \"   \"\n150 L$ = L$ + D$(M1,R) + SP$ + D$(M2,R)\n160 IF R=2 OR R=4 THEN L$ = L$ + \" : \"\n170 IF R<>2 AND R<>4 THEN L$ = L$ + \"   \"\n180 PRINT TAB(2); L$ + D$(S1,R) + SP$ + D$(S2,R)\n190 NEXT R\n200 FOR D=1 TO 950:NEXT D\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXXX\",\"X  X\",\"X  X\",\"X  X\",\"XXXX\", \"   X\",\"   X\",\"   X\",\"   X\",\"   X\"\n1010 DATA \"XXXX\",\"   X\",\"XXXX\",\"X   \",\"XXXX\", \"XXXX\",\"   X\",\"XXXX\",\"   X\",\"XXXX\"\n1020 DATA \"X  X\",\"X  X\",\"XXXX\",\"   X\",\"   X\", \"XXXX\",\"X   \",\"XXXX\",\"   X\",\"XXXX\"\n1030 DATA \"XXXX\",\"X   \",\"XXXX\",\"X  X\",\"XXXX\", \"XXXX\",\"   X\",\"   X\",\"   X\",\"   X\"\n1040 DATA \"XXXX\",\"X  X\",\"XXXX\",\"X  X\",\"XXXX\", \"XXXX\",\"X  X\",\"XXXX\",\"   X\",\"XXXX\"",
  "WS-CLOCK-FINAL": "10 REM SLEEP-SYNCHRONIZED BOUNCING CLOCK\n20 CLS:PRINT \"ENTER STARTING TIME:\"\n30 INPUT \"HOURS (0-23) \";HR\n40 INPUT \"MINUTES (0-59) \";MN\n50 INPUT \"SECONDS (0-59) \";SC\n60 REM INITIAL POSITION, DIRECTION, AND STEP COUNTER\n70 VP = 3: HP = 5: VD = 1: HD = 1: ST = 0\n80 REM MAIN DISPLAY LOOP\n90 CLS:IF VP < 1 THEN VP = 1\n100 FOR L = 1 TO VP:PRINT:NEXT L\n110 PRINT TAB(HP);\"+---------------------+\"\n120 PRINT TAB(HP);\"|                     |\"\n130 PRINT TAB(HP);\"|      \";\n140 IF HR < 10 THEN PRINT \"0\";\n150 PRINT HR;\":\";\n160 IF MN < 10 THEN PRINT \"0\";\n170 PRINT MN;\":\";\n180 IF SC < 10 THEN PRINT \"0\";\n190 PRINT SC;\"      |\"\n200 PRINT TAB(HP);\"|                     |\"\n210 PRINT TAB(HP);\"+---------------------+\"\n220 REM HARDWARE SLEEP LOCK FOR ACCURACY\n230 SLEEP 1\n240 REM TIME INCREMENT CALCULATION (EVERY 1 SECOND)\n250 SC = SC + 1:IF SC < 60 THEN GOTO 290\n260 SC = 0:MN = MN + 1:IF MN < 60 THEN GOTO 290\n270 MN = 0:HR = HR + 1:IF HR < 24 THEN GOTO 290\n280 HR = 0\n290 REM UPDATE SLOW PHYSICS (EVERY 10 SECONDS)\n300 ST = ST + 1:IF ST < 10 THEN GOTO 90\n310 ST = 0:REM RESET STEP COUNTER\n320 VP = VP + VD:IF VP >= 15 OR VP <= 1 THEN VD = -VD\n330 HP = HP + HD:IF HP >= 14 OR HP <= 1 THEN HD = -HD\n340 GOTO 90",
  "CLOCK11": "10 REM FINAL RECONSTRUCTED CLOCK\n20 DIM D$(9,3):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 3:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 PRINT CHR$(147);\"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM MAIN INTERACTIVE LOOP\n90 PRINT CHR$(147);:FOR L=1 TO 8:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 3\n120 PRINT TAB(4);D$(H1,R);SP$;D$(H2,R);\n130 IF R=1 OR R=3 THEN PRINT \"   \";\n140 IF R=2 THEN PRINT \" : \";\n150 PRINT D$(M1,R);SP$;D$(M2,R);\n160 IF R=1 OR R=3 THEN PRINT \"   \";\n170 IF R=2 THEN PRINT \" : \";\n180 PRINT D$(S1,R);SP$;D$(S2,R)\n190 NEXT R\n200 FOR D=1 TO 950:NEXT D\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXX\",\"X.X\",\"XXX\", \".X.\",\".X.\",\".X.\", \"XXX\",\"..X\",\"XXX\", \"XXX\",\"..X\",\"XXX\"\n1010 DATA \"X.X\",\"XXX\",\"..X\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"..X\",\"..X\"\n1020 DATA \"XXX\",\"XXX\",\"XXX\", \"XXX\",\"XXX\",\"..X\"",
  "CLOCK-DONE-SYNC": "10 REM 10-SECOND SLOW BOUNCE CLOCK\n20 CLS:PRINT \"ENTER STARTING TIME:\"\n30 INPUT \"HOURS (0-23) \";HR\n40 INPUT \"MINUTES (0-59) \";MN\n50 INPUT \"SECONDS (0-59) \";SC\n60 REM INITIAL POSITION, DIRECTION, AND STEP COUNTER\n70 VP = 3: HP = 5: VD = 1: HD = 1: ST = 0\n80 REM MAIN DISPLAY LOOP\n90 CLS:IF VP < 1 THEN VP = 1\n100 FOR L = 1 TO VP:PRINT:NEXT L\n110 PRINT TAB(HP);\"+---------------------+\"\n120 PRINT TAB(HP);\"|                     |\"\n130 PRINT TAB(HP);\"|      \";\n140 IF HR < 10 THEN PRINT \"0\";\n150 PRINT HR;\":\";\n160 IF MN < 10 THEN PRINT \"0\";\n170 PRINT MN;\":\";\n180 IF SC < 10 THEN PRINT \"0\";\n190 PRINT SC;\"      |\"\n200 PRINT TAB(HP);\"|                     |\"\n210 PRINT TAB(HP);\"+---------------------+\"\n220 REM OPTIMIZED CALIBRATION DELAY LOOP\n230 FOR D = 1 TO 74000:NEXT D\n240 REM TIME INCREMENT CALCULATION (EVERY 1 SECOND)\n250 SC = SC + 1:IF SC < 60 THEN GOTO 290\n260 SC = 0:MN = MN + 1:IF MN < 60 THEN GOTO 290\n270 MN = 0:HR = HR + 1:IF HR < 24 THEN GOTO 290\n280 HR = 0\n290 REM UPDATE SLOW PHYSICS (EVERY 10 SECONDS)\n300 ST = ST + 1:IF ST < 10 THEN GOTO 90\n310 ST = 0:REM RESET STEP COUNTER\n320 VP = VP + VD:IF VP >= 15 OR VP <= 1 THEN VD = -VD\n330 HP = HP + HD:IF HP >= 14 OR HP <= 1 THEN HD = -HD\n340 GOTO 90",
  "CLOCK_FINAL_FINAL": "10 REM GIANT 7X5 REAL-TIME BLOCK CLOCK\n20 DIM D$(9,7):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 7:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 CLS:PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM DISPLAY LOOP\n90 CLS:FOR L=1 TO 5:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 7\n120 L$ = D$(H1,R) + SP$ + D$(H2,R)\n130 IF R=2 OR R=3 OR R=5 OR R=6 THEN L$ = L$ + \" : \"\n140 IF R<>2 AND R<>3 AND R<>5 AND R<>6 THEN L$ = L$ + \"   \"\n150 L$ = L$ + D$(M1,R) + SP$ + D$(M2,R)\n160 IF R=2 OR R=3 OR R=5 OR R=6 THEN L$ = L$ + \" : \"\n170 IF R<>2 AND R<>3 AND R<>5 AND R<>6 THEN L$ = L$ + \"   \"\n180 PRINT TAB(1); L$ + D$(S1,R) + SP$ + D$(S2,R)\n190 NEXT R\n200 T=INT(TIME)\n205 IF INT(TIME)=T THEN GOTO 205\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXXXX\",\"X   X\",\"X   X\",\"X   X\",\"X   X\",\"X   X\",\"XXXXX\"\n1010 DATA \"    X\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\"\n1020 DATA \"XXXXX\",\"    X\",\"    X\",\"XXXXX\",\"X    \",\"X    \",\"XXXXX\"\n1030 DATA \"XXXXX\",\"    X\",\"    X\",\"XXXXX\",\"    X\",\"    X\",\"XXXXX\"\n1040 DATA \"X   X\",\"X   X\",\"X   X\",\"XXXXX\",\"    X\",\"    X\",\"    X\"\n1050 DATA \"XXXXX\",\"X    \",\"X    \",\"XXXXX\",\"    X\",\"    X\",\"XXXXX\"\n1060 DATA \"XXXXX\",\"X    \",\"X    \",\"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\"\n1070 DATA \"XXXXX\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\",\"    X\"\n1080 DATA \"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\"\n1090 DATA \"XXXXX\",\"X   X\",\"X   X\",\"XXXXX\",\"    X\",\"    X\",\"XXXXX\"",
  "CLOCKFINAL": "10 REM 10-SECOND SLOW BOUNCE CLOCK\n20 CLS:PRINT \"ENTER STARTING TIME:\"\n30 INPUT \"HOURS (0-23) \";HR\n40 INPUT \"MINUTES (0-59) \";MN\n50 INPUT \"SECONDS (0-59) \";SC\n60 REM INITIAL POSITION, DIRECTION, AND STEP COUNTER\n70 VP = 3: HP = 5: VD = 1: HD = 1: ST = 0\n80 REM MAIN DISPLAY LOOP\n90 CLS:IF VP < 1 THEN VP = 1\n100 FOR L = 1 TO VP:PRINT:NEXT L\n110 PRINT TAB(HP);\"+---------------------+\"\n120 PRINT TAB(HP);\"|                     |\"\n130 PRINT TAB(HP);\"|      \";\n140 IF HR < 10 THEN PRINT \"0\";\n150 PRINT HR;\":\";\n160 IF MN < 10 THEN PRINT \"0\";\n170 PRINT MN;\":\";\n180 IF SC < 10 THEN PRINT \"0\";\n190 PRINT SC;\"      |\"\n200 PRINT TAB(HP);\"|                     |\"\n210 PRINT TAB(HP);\"+---------------------+\"\n220 REM MIDDLE GROUND CALIBRATION LOOP\n230 FOR D = 1 TO 84000:NEXT D\n240 REM TIME INCREMENT CALCULATION (EVERY 1 SECOND)\n250 SC = SC + 1:IF SC < 60 THEN GOTO 290\n260 SC = 0:MN = MN + 1:IF MN < 60 THEN GOTO 290\n270 MN = 0:HR = HR + 1:IF HR < 24 THEN GOTO 290\n280 HR = 0\n290 REM UPDATE SLOW PHYSICS (EVERY 10 SECONDS)\n300 ST = ST + 1:IF ST < 10 THEN GOTO 90\n310 ST = 0:REM RESET STEP COUNTER\n320 VP = VP + VD:IF VP >= 15 OR VP <= 1 THEN VD = -VD\n330 HP = HP + HD:IF HP >= 14 OR HP <= 1 THEN HD = -HD\n340 GOTO 90",
  "KINGS_QUEST": "10 REM ==== QUEST FOR THE ENCHANTED CROWN ====\n20 SCREEN 1\n30 COLOR 9\n40 LINE (40,120)-(280,190),9,BF\n50 COLOR 8\n60 LINE (40,85)-(20,120)\n70 LINE (20,120)-(60,120)\n80 LINE (60,120)-(40,85)\n90 LINE (280,85)-(260,120)\n100 LINE (260,120)-(300,120)\n110 LINE (300,120)-(280,85)\n120 COLOR 0\n130 LINE (140,190)-(180,150),0,BF\n140 COLOR 14\n150 CIRCLE (160,60),15\n160 COLOR 2\n170 LINE (0,190)-(319,199),2,BF\n180 PRINT \"QUEST FOR THE ENCHANTED CROWN\"\n190 PRINT \"A KINGDOM ADVENTURE\"\n200 PRINT \"\"\n210 PRINT \"THE OLD KING IS DYING, AND HIS CROWN OF POWER HAS BEEN\"\n220 PRINT \"STOLEN BY A DRAGON. FIND THE SWORD AND THE AMULET, THEN\"\n230 PRINT \"FACE THE DRAGON AND BRING THE CROWN HOME.\"\n240 PRINT \"\"\n300 HASKEY = 0\n310 HASSWORD = 0\n320 HASAMULET = 0\n330 HASLOG = 0\n340 HASCROWN = 0\n350 WON = 0\n360 HEALTH = 100\n370 ROOM = 1\n380 VIS1 = 0 : VIS2 = 0 : VIS3 = 0 : VIS4 = 0 : VIS5 = 0 : VIS6 = 0 : VIS7 = 0\n400 IF HEALTH <= 0 THEN GOTO 9100\n410 IF ROOM = 1 THEN GOSUB 1000\n420 IF ROOM = 2 THEN GOSUB 2000\n430 IF ROOM = 3 THEN GOSUB 3000\n440 IF ROOM = 4 THEN GOSUB 4000\n450 IF ROOM = 5 THEN GOSUB 5000\n460 IF ROOM = 6 THEN GOSUB 6000\n470 IF ROOM = 7 THEN GOSUB 7000\n480 IF WON = 1 THEN GOTO 9000\n490 GOTO 400\n1000 REM --- CASTLE COURTYARD ---\n1010 PRINT \"\"\n1020 PRINT \"--- CASTLE COURTYARD ---\"\n1030 IF HASCROWN = 1 THEN PRINT \"1) GIVE THE CROWN TO THE KING\" : PRINT \"2) WANDER THE FOREST\" : PRINT \"3) VISIT THE VILLAGE\" : GOTO 1060\n1040 PRINT \"1) TALK TO THE KING\" : PRINT \"2) WANDER THE FOREST\" : PRINT \"3) VISIT THE VILLAGE\"\n1060 INPUT \"WHAT DO YOU DO\"; C\n1070 IF HASCROWN = 1 AND C = 1 THEN WON = 1 : RETURN\n1080 IF HASCROWN = 0 AND C = 1 THEN PRINT \"THE KING BEGS YOU TO RECOVER HIS STOLEN CROWN FROM THE DRAGON.\" : RETURN\n1090 IF C = 2 THEN ROOM = 2 : RETURN\n1100 IF C = 3 THEN ROOM = 3 : RETURN\n1110 PRINT \"NOTHING HAPPENS.\" : RETURN\n2000 REM --- DARK FOREST ---\n2010 PRINT \"\"\n2020 IF VIS2 = 0 THEN PRINT \"--- DARK FOREST ---\" : PRINT \"TWISTED TREES BLOCK THE SUN. PATHS LEAD TO A CAVE AND A RIVER.\" : VIS2 = 1 ELSE PRINT \"--- DARK FOREST ---\"\n2030 PRINT \"1) GO TO THE CAVE  2) GO TO THE RIVER  3) RETURN TO CASTLE\"\n2040 INPUT \"WHAT DO YOU DO\"; C\n2050 IF C = 1 THEN ROOM = 4 : RETURN\n2060 IF C = 2 THEN ROOM = 6 : RETURN\n2070 IF C = 3 THEN ROOM = 1 : RETURN\n2080 PRINT \"NOTHING HAPPENS.\" : RETURN\n3000 REM --- VILLAGE ---\n3010 PRINT \"\"\n3020 IF VIS3 = 0 THEN PRINT \"--- VILLAGE ---\" : PRINT \"THE BLACKSMITH RECOGNIZES YOU AND HANDS YOU A FINE SWORD.\" : HASSWORD = 1 : VIS3 = 1 ELSE PRINT \"--- VILLAGE ---\" : PRINT \"THE BLACKSMITH WAVES HELLO.\"\n3030 PRINT \"1) RETURN TO CASTLE\"\n3040 INPUT \"WHAT DO YOU DO\"; C\n3050 ROOM = 1 : RETURN\n4000 REM --- CAVE ---\n4010 PRINT \"\"\n4020 IF VIS4 = 0 THEN PRINT \"--- CAVE ---\" : PRINT \"YOU FIND A RUSTY KEY, AND HEAR A BAT SHRIEK OUT OF THE DARK.\" : HASKEY = 1 : HEALTH = HEALTH - 10 : VIS4 = 1 ELSE PRINT \"--- CAVE ---\"\n4030 PRINT \"1) GO DEEPER TO THE DRAGON'S LAIR  2) RETURN TO THE FOREST\"\n4040 INPUT \"WHAT DO YOU DO\"; C\n4050 IF C = 1 THEN ROOM = 5 : RETURN\n4060 IF C = 2 THEN ROOM = 2 : RETURN\n4070 PRINT \"NOTHING HAPPENS.\" : RETURN\n5000 REM --- DRAGON'S LAIR ---\n5010 PRINT \"\"\n5020 PRINT \"--- DRAGON'S LAIR ---\"\n5030 PRINT \"THE DRAGON COILS ATOP A GLITTERING CROWN, SMOKE CURLING FROM ITS NOSTRILS.\"\n5040 IF HASSWORD = 0 THEN PRINT \"YOU HAVE NO WEAPON. THE DRAGON SWATS YOU AWAY!\" : HEALTH = HEALTH - 20 : ROOM = 2 : RETURN\n5050 IF HASSWORD = 1 AND HASAMULET = 0 THEN PRINT \"YOU CHARGE WITH YOUR SWORD, BUT THE DRAGON'S FIRE SCORCHES YOU!\" : HEALTH = HEALTH - 30 : ROOM = 2 : RETURN\n5060 PRINT \"PROTECTED BY YOUR AMULET, YOU DRIVE YOUR SWORD HOME. THE DRAGON FALLS!\"\n5070 PRINT \"YOU CLAIM THE ENCHANTED CROWN.\"\n5080 HASCROWN = 1\n5090 ROOM = 1\n5100 RETURN\n6000 REM --- RIVERBANK ---\n6010 PRINT \"\"\n6020 IF VIS6 = 0 THEN PRINT \"--- RIVERBANK ---\" : PRINT \"A WIDE RIVER BLOCKS YOUR PATH. YOU SPOT A STURDY LOG NEARBY.\" : VIS6 = 1 ELSE PRINT \"--- RIVERBANK ---\"\n6030 IF HASLOG = 0 THEN PRINT \"1) DRAG THE LOG TO THE BANK  2) RETURN TO THE FOREST\" ELSE PRINT \"1) CROSS TO THE ISLAND ON THE LOG  2) RETURN TO THE FOREST\"\n6040 INPUT \"WHAT DO YOU DO\"; C\n6050 IF C = 1 AND HASLOG = 0 THEN PRINT \"YOU WRESTLE THE LOG INTO PLACE, READY TO CROSS.\" : HASLOG = 1 : RETURN\n6060 IF C = 1 AND HASLOG = 1 THEN ROOM = 7 : RETURN\n6070 IF C = 2 THEN ROOM = 2 : RETURN\n6080 PRINT \"NOTHING HAPPENS.\" : RETURN\n7000 REM --- ISLAND ---\n7010 PRINT \"\"\n7020 IF VIS7 = 0 THEN PRINT \"--- ISLAND ---\" : PRINT \"AN ANCIENT AMULET RESTS ON A STONE PEDESTAL, HUMMING WITH MAGIC.\" : HASAMULET = 1 : VIS7 = 1 ELSE PRINT \"--- ISLAND ---\"\n7030 PRINT \"1) CROSS BACK TO THE RIVERBANK\"\n7040 INPUT \"WHAT DO YOU DO\"; C\n7050 ROOM = 6\n7060 RETURN\n9000 REM --- VICTORY ---\n9010 PRINT \"\"\n9020 PRINT \"THE KING PLACES THE ENCHANTED CROWN UPON HIS HEAD, AND COLOR RETURNS\"\n9030 PRINT \"TO HIS CHEEKS. THE KINGDOM IS SAVED, AND YOUR NAME WILL BE SUNG FOR\"\n9040 PRINT \"GENERATIONS.\"\n9050 PRINT \"\"\n9060 PRINT \"*** YOU HAVE WON! ***\"\n9070 END\n9100 REM --- DEFEAT ---\n9110 PRINT \"\"\n9120 PRINT \"YOUR STRENGTH FAILS YOU, AND YOUR QUEST ENDS HERE.\"\n9130 PRINT \"\"\n9140 PRINT \"*** GAME OVER ***\"\n9150 END",
  "CLOCK_FINAL-DONE": "10 REM 10-SECOND SLOW BOUNCE CLOCK\n20 CLS:PRINT \"ENTER STARTING TIME:\"\n30 INPUT \"HOURS (0-23) \";HR\n40 INPUT \"MINUTES (0-59) \";MN\n50 INPUT \"SECONDS (0-59) \";SC\n60 REM INITIAL POSITION, DIRECTION, AND STEP COUNTER\n70 VP = 3: HP = 5: VD = 1: HD = 1: ST = 0\n80 REM MAIN DISPLAY LOOP\n90 CLS:IF VP < 1 THEN VP = 1\n100 FOR L = 1 TO VP:PRINT:NEXT L\n110 PRINT TAB(HP);\"+---------------------+\"\n120 PRINT TAB(HP);\"|                     |\"\n130 PRINT TAB(HP);\"|      \";\n140 IF HR < 10 THEN PRINT \"0\";\n150 PRINT HR;\":\";\n160 IF MN < 10 THEN PRINT \"0\";\n170 PRINT MN;\":\";\n180 IF SC < 10 THEN PRINT \"0\";\n190 PRINT SC;\"      |\"\n200 PRINT TAB(HP);\"|                     |\"\n210 PRINT TAB(HP);\"+---------------------+\"\n220 REM THE PERFECT TIME CALIBRATION ADJUSTMENT\n230 FOR D = 1 TO 64800:NEXT D\n240 REM TIME INCREMENT CALCULATION (EVERY 1 SECOND)\n250 SC = SC + 1:IF SC < 60 THEN GOTO 290\n260 SC = 0:MN = MN + 1:IF MN < 60 THEN GOTO 290\n270 MN = 0:HR = HR + 1:IF HR < 24 THEN GOTO 290\n280 HR = 0\n290 REM UPDATE SLOW PHYSICS (EVERY 10 SECONDS)\n300 ST = ST + 1:IF ST < 10 THEN GOTO 90\n310 ST = 0:REM RESET STEP COUNTER\n320 VP = VP + VD:IF VP >= 15 OR VP <= 1 THEN VD = -VD\n330 HP = HP + HD:IF HP >= 14 OR HP <= 1 THEN HD = -HD\n340 GOTO 90",
  "CLOCK-FINAL-B4": "10 REM 100% PERFECT HIGH-VISIBILITY DIGITAL CLOCK\n20 DIM D$(9,3):BL$=\"X\":SP$=\" \"\n30 FOR X=0 TO 9:FOR Y=1 TO 3:READ A$:D$(X,Y)=A$:NEXT Y:NEXT X\n40 CLS:PRINT \"ENTER STARTING TIME:\"\n50 INPUT \"HOURS (0-23) \";HR\n60 INPUT \"MINUTES (0-59) \";MN\n70 INPUT \"SECONDS (0-59) \";SC\n80 REM MAIN INTERACTIVE LOOP\n90 CLS:FOR L=1 TO 8:PRINT:NEXT L\n100 H1=INT(HR/10):H2=HR-(H1*10):M1=INT(MN/10):M2=MN-(M1*10):S1=INT(SC/10):S2=SC-(S1*10)\n110 FOR R=1 TO 3\n120 L$ = D$(H1,R) + SP$ + D$(H2,R)\n130 IF R=2 THEN L$ = L$ + \" : \"\n140 IF R<>2 THEN L$ = L$ + \"   \"\n150 L$ = L$ + D$(M1,R) + SP$ + D$(M2,R)\n160 IF R=2 THEN L$ = L$ + \" : \"\n170 IF R<>2 THEN L$ = L$ + \"   \"\n180 PRINT TAB(4); L$ + D$(S1,R) + SP$ + D$(S2,R)\n190 NEXT R\n200 FOR D=1 TO 950:NEXT D\n210 SC=SC+1:IF SC<60 THEN GOTO 90\n220 SC=0:MN=MN+1:IF MN<60 THEN GOTO 90\n230 MN=0:HR=HR+1:IF HR<24 THEN GOTO 90\n240 HR=0:GOTO 90\n1000 DATA \"XXX\",\"X X\",\"XXX\", \"  X\",\"  X\",\"  X\", \"XXX\",\"  X\",\"XXX\", \"XXX\",\"  X\",\"XXX\"\n1010 DATA \"X X\",\"XXX\",\"  X\", \"XXX\",\"X  \",\"XXX\", \"XXX\",\"X X\",\"XXX\", \"XXX\",\"  X\",\"  X\"\n1020 DATA \"XXX\",\"X X\",\"XXX\", \"XXX\",\"XXX\",\"  X\"",
  "CLOCKFINALSYNC": "10 REM 10-SECOND SLOW BOUNCE CLOCK\n20 CLS:PRINT \"ENTER STARTING TIME:\"\n30 INPUT \"HOURS (0-23) \";HR\n40 INPUT \"MINUTES (0-59) \";MN\n50 INPUT \"SECONDS (0-59) \";SC\n60 REM INITIAL POSITION, DIRECTION, AND STEP COUNTER\n70 VP = 3: HP = 5: VD = 1: HD = 1: ST = 0\n80 REM MAIN DISPLAY LOOP\n90 CLS:IF VP < 1 THEN VP = 1\n100 FOR L = 1 TO VP:PRINT:NEXT L\n110 PRINT TAB(HP);\"+---------------------+\"\n120 PRINT TAB(HP);\"|                     |\"\n130 PRINT TAB(HP);\"|      \";\n140 IF HR < 10 THEN PRINT \"0\";\n150 PRINT HR;\":\";\n160 IF MN < 10 THEN PRINT \"0\";\n170 PRINT MN;\":\";\n180 IF SC < 10 THEN PRINT \"0\";\n190 PRINT SC;\"      |\"\n200 PRINT TAB(HP);\"|                     |\"\n210 PRINT TAB(HP);\"+---------------------+\"\n220 REM FINE-TUNED PERFECT CALIBRATION LOOP\n230 FOR D = 1 TO 66500:NEXT D\n240 REM TIME INCREMENT CALCULATION (EVERY 1 SECOND)\n250 SC = SC + 1:IF SC < 60 THEN GOTO 290\n260 SC = 0:MN = MN + 1:IF MN < 60 THEN GOTO 290\n270 MN = 0:HR = HR + 1:IF HR < 24 THEN GOTO 290\n280 HR = 0\n290 REM UPDATE SLOW PHYSICS (EVERY 10 SECONDS)\n300 ST = ST + 1:IF ST < 10 THEN GOTO 90\n310 ST = 0:REM RESET STEP COUNTER\n320 VP = VP + VD:IF VP >= 15 OR VP <= 1 THEN VD = -VD\n330 HP = HP + HD:IF HP >= 14 OR HP <= 1 THEN HD = -HD\n340 GOTO 90"
 }
}