{
 "format": "MACBASIC-FLOPPY-V1",
 "created": "2026-08-31T11:01:39.352Z",
 "programs": {
  "SYSMON": "10 REM ==== MACBASIC SYSTEM MONITOR ====\n20 SCREEN 1\n30 CPU = 40\n40 MEM = 55\n50 DISK = 70\n60 NET = 20\n70 DIM CPUHIST(39)\n80 FOR I = 0 TO 39\n90 CPUHIST(I) = 40\n100 NEXT I\n110 UPTIME = 0\n200 REM ==== MAIN REFRESH LOOP ====\n210 CPU = CPU + (RND(1) - 0.5) * 18\n220 IF CPU < 3 THEN CPU = 3\n230 IF CPU > 97 THEN CPU = 97\n240 MEM = MEM + (RND(1) - 0.5) * 6\n250 IF MEM < 10 THEN MEM = 10\n260 IF MEM > 95 THEN MEM = 95\n270 DISK = DISK + (RND(1) - 0.5) * 2\n280 IF DISK < 0 THEN DISK = 0\n290 IF DISK > 99 THEN DISK = 99\n300 NET = NET + (RND(1) - 0.5) * 30\n310 IF NET < 0 THEN NET = 0\n320 IF NET > 100 THEN NET = 100\n330 UPTIME = UPTIME + 1\n340 FOR I = 0 TO 38\n350 CPUHIST(I) = CPUHIST(I + 1)\n360 NEXT I\n370 CPUHIST(39) = CPU\n400 CLS\n410 PRINT \"MACBASIC SYSTEM MONITOR    UPTIME: \"; UPTIME; \"S\"\n420 PRINT \"----------------------------------------\"\n430 PRINT \"CPU  \"; INT(CPU); \"%\"\n440 PRINT \"MEM  \"; INT(MEM); \"%\"\n450 PRINT \"DISK \"; INT(DISK); \"%\"\n460 PRINT \"NET  \"; INT(NET); \"%\"\n470 PRINT \"(PRESS CTRL+C TO STOP MONITORING)\"\n500 REM --- DRAW GAUGES ---\n510 COLOR 7\n520 LINE (10,85)-(310,97),7,B\n530 LINE (10,105)-(310,117),7,B\n540 LINE (10,125)-(310,137),7,B\n550 LINE (10,145)-(310,157),7,B\n560 W = 10 + (CPU / 100) * 300\n570 LINE (10,85)-(W,97),10,BF\n580 W = 10 + (MEM / 100) * 300\n590 LINE (10,105)-(W,117),11,BF\n600 W = 10 + (DISK / 100) * 300\n610 LINE (10,125)-(W,137),14,BF\n620 W = 10 + (NET / 100) * 300\n630 LINE (10,145)-(W,157),12,BF\n700 REM --- DRAW CPU HISTORY GRAPH ---\n710 LINE (10,165)-(310,195),7,B\n720 FOR I = 0 TO 38\n730 X1 = 10 + I * 7.5\n740 Y1 = 195 - (CPUHIST(I) / 100) * 28\n750 X2 = 10 + (I + 1) * 7.5\n760 Y2 = 195 - (CPUHIST(I + 1) / 100) * 28\n770 LINE (X1,Y1)-(X2,Y2),10\n780 NEXT I\n900 SLEEP 0.4\n910 GOTO 200",
  "PICTURE_BG": "10 REM ==== RETRO POSTCARD ====\n20 SCREEN 1\n30 REM STARFIELD\n40 COLOR 15\n50 FOR I = 1 TO 60\n60 SX = INT(RND(1) * 320)\n70 SY = INT(RND(1) * 120)\n80 PSET (SX,SY)\n90 NEXT I\n100 REM SUN\n110 COLOR 14\n120 CIRCLE (270,40),25\n130 REM GROUND\n140 COLOR 2\n150 LINE (0,150)-(319,199),2,BF\n160 REM MOUNTAIN\n170 COLOR 8\n180 LINE (0,150)-(80,100)\n190 LINE (80,100)-(160,150)\n200 REM HOUSE WALLS\n210 COLOR 4\n220 LINE (110,110)-(170,150),4,BF\n230 REM ROOF\n240 COLOR 6\n250 LINE (100,110)-(140,80)\n260 LINE (140,80)-(180,110)\n270 LINE (180,110)-(100,110)\n280 REM DOOR\n290 COLOR 0\n300 LINE (135,150)-(150,125),0,BF\n310 PRINT \"A QUIET EVENING ON THE FRONTIER.\"",
  "KINGS_QUEST": "10 REM ==== QUEST FOR THE ENCHANTED CROWN ====\n20 SCREEN 1\n30 COLOR 9\n40 LINE (40,120)-(280,190),9,BF\n50 COLOR 8\n60 LINE (40,85)-(20,120)\n70 LINE (20,120)-(60,120)\n80 LINE (60,120)-(40,85)\n90 LINE (280,85)-(260,120)\n100 LINE (260,120)-(300,120)\n110 LINE (300,120)-(280,85)\n120 COLOR 0\n130 LINE (140,190)-(180,150),0,BF\n140 COLOR 14\n150 CIRCLE (160,60),15\n160 COLOR 2\n170 LINE (0,190)-(319,199),2,BF\n180 PRINT \"QUEST FOR THE ENCHANTED CROWN\"\n190 PRINT \"A KINGDOM ADVENTURE\"\n200 PRINT \"\"\n210 PRINT \"THE OLD KING IS DYING, AND HIS CROWN OF POWER HAS BEEN\"\n220 PRINT \"STOLEN BY A DRAGON. FIND THE SWORD AND THE AMULET, THEN\"\n230 PRINT \"FACE THE DRAGON AND BRING THE CROWN HOME.\"\n240 PRINT \"\"\n300 HASKEY = 0\n310 HASSWORD = 0\n320 HASAMULET = 0\n330 HASLOG = 0\n340 HASCROWN = 0\n350 WON = 0\n360 HEALTH = 100\n370 ROOM = 1\n380 VIS1 = 0 : VIS2 = 0 : VIS3 = 0 : VIS4 = 0 : VIS5 = 0 : VIS6 = 0 : VIS7 = 0\n400 IF HEALTH <= 0 THEN GOTO 9100\n410 IF ROOM = 1 THEN GOSUB 1000\n420 IF ROOM = 2 THEN GOSUB 2000\n430 IF ROOM = 3 THEN GOSUB 3000\n440 IF ROOM = 4 THEN GOSUB 4000\n450 IF ROOM = 5 THEN GOSUB 5000\n460 IF ROOM = 6 THEN GOSUB 6000\n470 IF ROOM = 7 THEN GOSUB 7000\n480 IF WON = 1 THEN GOTO 9000\n490 GOTO 400\n1000 REM --- CASTLE COURTYARD ---\n1010 PRINT \"\"\n1020 PRINT \"--- CASTLE COURTYARD ---\"\n1030 IF HASCROWN = 1 THEN PRINT \"1) GIVE THE CROWN TO THE KING\" : PRINT \"2) WANDER THE FOREST\" : PRINT \"3) VISIT THE VILLAGE\" : GOTO 1060\n1040 PRINT \"1) TALK TO THE KING\" : PRINT \"2) WANDER THE FOREST\" : PRINT \"3) VISIT THE VILLAGE\"\n1060 INPUT \"WHAT DO YOU DO\"; C\n1070 IF HASCROWN = 1 AND C = 1 THEN WON = 1 : RETURN\n1080 IF HASCROWN = 0 AND C = 1 THEN PRINT \"THE KING BEGS YOU TO RECOVER HIS STOLEN CROWN FROM THE DRAGON.\" : RETURN\n1090 IF C = 2 THEN ROOM = 2 : RETURN\n1100 IF C = 3 THEN ROOM = 3 : RETURN\n1110 PRINT \"NOTHING HAPPENS.\" : RETURN\n2000 REM --- DARK FOREST ---\n2010 PRINT \"\"\n2020 IF VIS2 = 0 THEN PRINT \"--- DARK FOREST ---\" : PRINT \"TWISTED TREES BLOCK THE SUN. PATHS LEAD TO A CAVE AND A RIVER.\" : VIS2 = 1 ELSE PRINT \"--- DARK FOREST ---\"\n2030 PRINT \"1) GO TO THE CAVE  2) GO TO THE RIVER  3) RETURN TO CASTLE\"\n2040 INPUT \"WHAT DO YOU DO\"; C\n2050 IF C = 1 THEN ROOM = 4 : RETURN\n2060 IF C = 2 THEN ROOM = 6 : RETURN\n2070 IF C = 3 THEN ROOM = 1 : RETURN\n2080 PRINT \"NOTHING HAPPENS.\" : RETURN\n3000 REM --- VILLAGE ---\n3010 PRINT \"\"\n3020 IF VIS3 = 0 THEN PRINT \"--- VILLAGE ---\" : PRINT \"THE BLACKSMITH RECOGNIZES YOU AND HANDS YOU A FINE SWORD.\" : HASSWORD = 1 : VIS3 = 1 ELSE PRINT \"--- VILLAGE ---\" : PRINT \"THE BLACKSMITH WAVES HELLO.\"\n3030 PRINT \"1) RETURN TO CASTLE\"\n3040 INPUT \"WHAT DO YOU DO\"; C\n3050 ROOM = 1 : RETURN\n4000 REM --- CAVE ---\n4010 PRINT \"\"\n4020 IF VIS4 = 0 THEN PRINT \"--- CAVE ---\" : PRINT \"YOU FIND A RUSTY KEY, AND HEAR A BAT SHRIEK OUT OF THE DARK.\" : HASKEY = 1 : HEALTH = HEALTH - 10 : VIS4 = 1 ELSE PRINT \"--- CAVE ---\"\n4030 PRINT \"1) GO DEEPER TO THE DRAGON'S LAIR  2) RETURN TO THE FOREST\"\n4040 INPUT \"WHAT DO YOU DO\"; C\n4050 IF C = 1 THEN ROOM = 5 : RETURN\n4060 IF C = 2 THEN ROOM = 2 : RETURN\n4070 PRINT \"NOTHING HAPPENS.\" : RETURN\n5000 REM --- DRAGON'S LAIR ---\n5010 PRINT \"\"\n5020 PRINT \"--- DRAGON'S LAIR ---\"\n5030 PRINT \"THE DRAGON COILS ATOP A GLITTERING CROWN, SMOKE CURLING FROM ITS NOSTRILS.\"\n5040 IF HASSWORD = 0 THEN PRINT \"YOU HAVE NO WEAPON. THE DRAGON SWATS YOU AWAY!\" : HEALTH = HEALTH - 20 : ROOM = 2 : RETURN\n5050 IF HASSWORD = 1 AND HASAMULET = 0 THEN PRINT \"YOU CHARGE WITH YOUR SWORD, BUT THE DRAGON'S FIRE SCORCHES YOU!\" : HEALTH = HEALTH - 30 : ROOM = 2 : RETURN\n5060 PRINT \"PROTECTED BY YOUR AMULET, YOU DRIVE YOUR SWORD HOME. THE DRAGON FALLS!\"\n5070 PRINT \"YOU CLAIM THE ENCHANTED CROWN.\"\n5080 HASCROWN = 1\n5090 ROOM = 1\n5100 RETURN\n6000 REM --- RIVERBANK ---\n6010 PRINT \"\"\n6020 IF VIS6 = 0 THEN PRINT \"--- RIVERBANK ---\" : PRINT \"A WIDE RIVER BLOCKS YOUR PATH. YOU SPOT A STURDY LOG NEARBY.\" : VIS6 = 1 ELSE PRINT \"--- RIVERBANK ---\"\n6030 IF HASLOG = 0 THEN PRINT \"1) DRAG THE LOG TO THE BANK  2) RETURN TO THE FOREST\" ELSE PRINT \"1) CROSS TO THE ISLAND ON THE LOG  2) RETURN TO THE FOREST\"\n6040 INPUT \"WHAT DO YOU DO\"; C\n6050 IF C = 1 AND HASLOG = 0 THEN PRINT \"YOU WRESTLE THE LOG INTO PLACE, READY TO CROSS.\" : HASLOG = 1 : RETURN\n6060 IF C = 1 AND HASLOG = 1 THEN ROOM = 7 : RETURN\n6070 IF C = 2 THEN ROOM = 2 : RETURN\n6080 PRINT \"NOTHING HAPPENS.\" : RETURN\n7000 REM --- ISLAND ---\n7010 PRINT \"\"\n7020 IF VIS7 = 0 THEN PRINT \"--- ISLAND ---\" : PRINT \"AN ANCIENT AMULET RESTS ON A STONE PEDESTAL, HUMMING WITH MAGIC.\" : HASAMULET = 1 : VIS7 = 1 ELSE PRINT \"--- ISLAND ---\"\n7030 PRINT \"1) CROSS BACK TO THE RIVERBANK\"\n7040 INPUT \"WHAT DO YOU DO\"; C\n7050 ROOM = 6\n7060 RETURN\n9000 REM --- VICTORY ---\n9010 PRINT \"\"\n9020 PRINT \"THE KING PLACES THE ENCHANTED CROWN UPON HIS HEAD, AND COLOR RETURNS\"\n9030 PRINT \"TO HIS CHEEKS. THE KINGDOM IS SAVED, AND YOUR NAME WILL BE SUNG FOR\"\n9040 PRINT \"GENERATIONS.\"\n9050 PRINT \"\"\n9060 PRINT \"*** YOU HAVE WON! ***\"\n9070 END\n9100 REM --- DEFEAT ---\n9110 PRINT \"\"\n9120 PRINT \"YOUR STRENGTH FAILS YOU, AND YOUR QUEST ENDS HERE.\"\n9130 PRINT \"\"\n9140 PRINT \"*** GAME OVER ***\"\n9150 END",
  "HUNT": "10 REM ==== STARBASE NUMBER HUNT ====\n20 PRINT \"STARBASE NUMBER HUNT\"\n30 PRINT \"GUESS THE SECRET NUMBER (1-100) IN AS FEW TRIES AS POSSIBLE.\"\n40 PRINT \"\"\n50 DIM SCORES(3)\n60 FOR ROUND = 1 TO 3\n70 T = INT(RND(1) * 100) + 1\n80 G = 0\n90 PRINT \"--- ROUND \"; ROUND; \" ---\"\n100 GOSUB 500\n110 SCORES(ROUND) = G\n120 NEXT ROUND\n130 PRINT \"\"\n140 PRINT \"FINAL RESULTS:\"\n150 TOTAL = 0\n160 FOR ROUND = 1 TO 3\n170 PRINT \"ROUND \"; ROUND; \": \"; SCORES(ROUND); \" GUESSES\"\n180 TOTAL = TOTAL + SCORES(ROUND)\n190 NEXT ROUND\n200 AVG = INT(TOTAL / 3 * 100 + 0.5) / 100\n210 PRINT \"AVERAGE GUESSES: \"; AVG\n220 IF AVG <= 5 THEN PRINT \"RANK: ACE NAVIGATOR\"\n230 IF AVG > 5 AND AVG <= 8 THEN PRINT \"RANK: SOLID PILOT\"\n240 IF AVG > 8 THEN PRINT \"RANK: KEEP PRACTICING, CADET\"\n250 END\n500 REM --- GUESS LOOP SUBROUTINE ---\n510 INPUT \"YOUR GUESS\"; GS\n520 G = G + 1\n530 IF GS = T THEN GOTO 570\n540 IF GS < T THEN PRINT \"TOO LOW\"\n550 IF GS > T THEN PRINT \"TOO HIGH\"\n560 GOTO 510\n570 PRINT \"CORRECT! IT TOOK YOU \"; G; \" GUESSES.\"\n580 RETURN",
  "NUMBER_SQ": "10 FOR I = 1 TO 5\n20 PRINT I; \"SQUARED IS\"; I*I\n30 NEXT I",
  "STARBASE": "10 REM ==== STARBASE NUMBER HUNT ====\n20 PRINT \"STARBASE NUMBER HUNT\"\n30 PRINT \"GUESS THE SECRET NUMBER (1-100) IN AS FEW TRIES AS POSSIBLE.\"\n40 PRINT \"\"\n50 DIM SCORES(3)\n60 FOR ROUND = 1 TO 3\n70 T = INT(RND(1) * 100) + 1\n80 G = 0\n90 PRINT \"--- ROUND \"; ROUND; \" ---\"\n100 GOSUB 500\n110 SCORES(ROUND) = G\n120 NEXT ROUND\n130 PRINT \"\"\n140 PRINT \"FINAL RESULTS:\"\n150 TOTAL = 0\n160 FOR ROUND = 1 TO 3\n170 PRINT \"ROUND \"; ROUND; \": \"; SCORES(ROUND); \" GUESSES\"\n180 TOTAL = TOTAL + SCORES(ROUND)\n190 NEXT ROUND\n200 AVG = INT(TOTAL / 3 * 100 + 0.5) / 100\n210 PRINT \"AVERAGE GUESSES: \"; AVG\n220 IF AVG <= 5 THEN PRINT \"RANK: ACE NAVIGATOR\"\n230 IF AVG > 5 AND AVG <= 8 THEN PRINT \"RANK: SOLID PILOT\"\n240 IF AVG > 8 THEN PRINT \"RANK: KEEP PRACTICING, CADET\"\n250 END\n500 REM --- GUESS LOOP SUBROUTINE ---\n510 INPUT \"YOUR GUESS\"; GS\n520 G = G + 1\n530 IF GS = T THEN GOTO 570\n540 IF GS < T THEN PRINT \"TOO LOW\"\n550 IF GS > T THEN PRINT \"TOO HIGH\"\n560 GOTO 510\n570 PRINT \"CORRECT! IT TOOK YOU \"; G; \" GUESSES.\"\n580 RETURN",
  "OREGON_TRAIL": "10 REM ==== OREGON TRAIL: TEXT EDITION ====\n20 PRINT \"OREGON TRAIL - TEXT EDITION\"\n30 PRINT \"THE YEAR IS 1848. LEAD YOUR WAGON PARTY 2000 MILES TO OREGON.\"\n40 PRINT \"\"\n50 MONEY = 400\n60 FOOD = 200\n70 HEALTH = 100\n80 OXEN = 2\n90 MILES = 0\n100 DAY = 1\n110 REM --- BUY SUPPLIES ---\n120 PRINT \"YOU HAVE $\"; MONEY; \" TO SPEND ON SUPPLIES.\"\n130 INPUT \"OXEN TO BUY (40 DOLLARS EACH)\"; BOX\n140 IF BOX * 40 > MONEY THEN PRINT \"YOU CANNOT AFFORD THAT.\" : GOTO 130\n150 OXEN = OXEN + BOX\n160 MONEY = MONEY - BOX * 40\n170 INPUT \"POUNDS OF FOOD TO BUY (0.2 DOLLARS PER LB)\"; BFOOD\n180 IF BFOOD * 0.2 > MONEY THEN PRINT \"YOU CANNOT AFFORD THAT.\" : GOTO 170\n190 FOOD = FOOD + BFOOD\n200 MONEY = MONEY - BFOOD * 0.2\n210 PRINT \"YOU HAVE $\"; MONEY; \" REMAINING. GOOD LUCK!\"\n220 PRINT \"\"\n230 REM ==== MAIN TRAVEL LOOP ====\n240 IF MILES >= 2000 THEN GOTO 900\n250 IF HEALTH <= 0 THEN GOTO 950\n260 IF FOOD <= 0 THEN HEALTH = HEALTH - 5\n270 PRINT \"DAY \"; DAY; \"  MILES: \"; MILES; \"  FOOD: \"; FOOD; \"  HEALTH: \"; HEALTH\n280 PRINT \"1) CONTINUE  2) HUNT  3) REST  4) CHECK STATUS\"\n290 INPUT \"YOUR CHOICE\"; CHOICE\n300 IF CHOICE = 1 THEN GOSUB 400\n310 IF CHOICE = 2 THEN GOSUB 500\n320 IF CHOICE = 3 THEN GOSUB 600\n330 IF CHOICE = 4 THEN GOSUB 700\n340 DAY = DAY + 1\n350 GOSUB 800\n360 GOTO 240\n400 REM --- CONTINUE TRAVELING ---\n410 D = 15 + INT(RND(1) * 10)\n420 MILES = MILES + D\n430 FOOD = FOOD - 10\n440 PRINT \"YOU TRAVELED \"; D; \" MILES.\"\n450 RETURN\n500 REM --- HUNT ---\n510 CATCH = INT(RND(1) * 60)\n520 FOOD = FOOD + CATCH\n530 PRINT \"YOU HUNTED AND GATHERED \"; CATCH; \" POUNDS OF FOOD.\"\n540 RETURN\n600 REM --- REST ---\n610 HEALTH = HEALTH + 10\n620 IF HEALTH > 100 THEN HEALTH = 100\n630 FOOD = FOOD - 5\n640 PRINT \"YOUR PARTY RESTS AND RECOVERS SOME HEALTH.\"\n650 RETURN\n700 REM --- CHECK STATUS ---\n710 PRINT \"MONEY: $\"; MONEY; \"  OXEN: \"; OXEN; \"  DAY: \"; DAY\n720 RETURN\n800 REM --- RANDOM EVENT ---\n810 EV = INT(RND(1) * 10)\n820 IF EV = 0 THEN PRINT \"A WHEEL BREAKS! YOU LOSE TIME AND STRENGTH.\" : HEALTH = HEALTH - 5\n830 IF EV = 1 THEN PRINT \"SOMEONE HAS DYSENTERY.\" : HEALTH = HEALTH - 10\n840 IF EV = 2 THEN PRINT \"YOU FIND A FRIENDLY TRADING POST.\" : FOOD = FOOD + 20\n850 IF EV = 3 THEN PRINT \"A RIVER CROSSING SOAKS YOUR SUPPLIES.\" : FOOD = FOOD - 15\n860 RETURN\n900 REM --- WIN ---\n910 PRINT \"\"\n920 PRINT \"CONGRATULATIONS! YOU REACHED OREGON ON DAY \"; DAY; \"!\"\n930 PRINT \"FINAL HEALTH: \"; HEALTH; \"  FOOD LEFT: \"; FOOD\n940 END\n950 REM --- LOSE ---\n960 PRINT \"\"\n970 PRINT \"YOUR PARTY HAS PERISHED ON THE TRAIL.\"\n980 PRINT \"YOU MADE IT \"; MILES; \" MILES BEFORE DAY \"; DAY; \".\"\n990 END"
 }
}