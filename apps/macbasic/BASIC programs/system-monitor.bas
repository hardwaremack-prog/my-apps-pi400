10 REM ==== MACBASIC SYSTEM MONITOR ====
20 SCREEN 1
30 CPU = 40
40 MEM = 55
50 DISK = 70
60 NET = 20
70 DIM CPUHIST(39)
80 FOR I = 0 TO 39
90 CPUHIST(I) = 40
100 NEXT I
110 UPTIME = 0
200 REM ==== MAIN REFRESH LOOP ====
210 CPU = CPU + (RND(1) - 0.5) * 18
220 IF CPU < 3 THEN CPU = 3
230 IF CPU > 97 THEN CPU = 97
240 MEM = MEM + (RND(1) - 0.5) * 6
250 IF MEM < 10 THEN MEM = 10
260 IF MEM > 95 THEN MEM = 95
270 DISK = DISK + (RND(1) - 0.5) * 2
280 IF DISK < 0 THEN DISK = 0
290 IF DISK > 99 THEN DISK = 99
300 NET = NET + (RND(1) - 0.5) * 30
310 IF NET < 0 THEN NET = 0
320 IF NET > 100 THEN NET = 100
330 UPTIME = UPTIME + 1
340 FOR I = 0 TO 38
350 CPUHIST(I) = CPUHIST(I + 1)
360 NEXT I
370 CPUHIST(39) = CPU
400 CLS
410 PRINT "MACBASIC SYSTEM MONITOR    UPTIME: "; UPTIME; "S"
420 PRINT "----------------------------------------"
430 PRINT "CPU  "; INT(CPU); "%"
440 PRINT "MEM  "; INT(MEM); "%"
450 PRINT "DISK "; INT(DISK); "%"
460 PRINT "NET  "; INT(NET); "%"
470 PRINT "(PRESS CTRL+C TO STOP MONITORING)"
500 REM --- DRAW GAUGES ---
510 COLOR 7
520 LINE (10,85)-(310,97),7,B
530 LINE (10,105)-(310,117),7,B
540 LINE (10,125)-(310,137),7,B
550 LINE (10,145)-(310,157),7,B
560 W = 10 + (CPU / 100) * 300
570 LINE (10,85)-(W,97),10,BF
580 W = 10 + (MEM / 100) * 300
590 LINE (10,105)-(W,117),11,BF
600 W = 10 + (DISK / 100) * 300
610 LINE (10,125)-(W,137),14,BF
620 W = 10 + (NET / 100) * 300
630 LINE (10,145)-(W,157),12,BF
700 REM --- DRAW CPU HISTORY GRAPH ---
710 LINE (10,165)-(310,195),7,B
720 FOR I = 0 TO 38
730 X1 = 10 + I * 7.5
740 Y1 = 195 - (CPUHIST(I) / 100) * 28
750 X2 = 10 + (I + 1) * 7.5
760 Y2 = 195 - (CPUHIST(I + 1) / 100) * 28
770 LINE (X1,Y1)-(X2,Y2),10
780 NEXT I
900 SLEEP 0.4
910 GOTO 200
