10 REM ==== QUEST FOR THE ENCHANTED CROWN ====
20 SCREEN 1
30 COLOR 9
40 LINE (40,120)-(280,190),9,BF
50 COLOR 8
60 LINE (40,85)-(20,120)
70 LINE (20,120)-(60,120)
80 LINE (60,120)-(40,85)
90 LINE (280,85)-(260,120)
100 LINE (260,120)-(300,120)
110 LINE (300,120)-(280,85)
120 COLOR 0
130 LINE (140,190)-(180,150),0,BF
140 COLOR 14
150 CIRCLE (160,60),15
160 COLOR 2
170 LINE (0,190)-(319,199),2,BF
180 PRINT "QUEST FOR THE ENCHANTED CROWN"
190 PRINT "A KINGDOM ADVENTURE"
200 PRINT ""
210 PRINT "THE OLD KING IS DYING, AND HIS CROWN OF POWER HAS BEEN"
220 PRINT "STOLEN BY A DRAGON. FIND THE SWORD AND THE AMULET, THEN"
230 PRINT "FACE THE DRAGON AND BRING THE CROWN HOME."
240 PRINT ""
300 HASKEY = 0
310 HASSWORD = 0
320 HASAMULET = 0
330 HASLOG = 0
340 HASCROWN = 0
350 WON = 0
360 HEALTH = 100
370 ROOM = 1
380 VIS1 = 0 : VIS2 = 0 : VIS3 = 0 : VIS4 = 0 : VIS5 = 0 : VIS6 = 0 : VIS7 = 0
400 IF HEALTH <= 0 THEN GOTO 9100
410 IF ROOM = 1 THEN GOSUB 1000
420 IF ROOM = 2 THEN GOSUB 2000
430 IF ROOM = 3 THEN GOSUB 3000
440 IF ROOM = 4 THEN GOSUB 4000
450 IF ROOM = 5 THEN GOSUB 5000
460 IF ROOM = 6 THEN GOSUB 6000
470 IF ROOM = 7 THEN GOSUB 7000
480 IF WON = 1 THEN GOTO 9000
490 GOTO 400
1000 REM --- CASTLE COURTYARD ---
1010 PRINT ""
1020 PRINT "--- CASTLE COURTYARD ---"
1030 IF HASCROWN = 1 THEN PRINT "1) GIVE THE CROWN TO THE KING" : PRINT "2) WANDER THE FOREST" : PRINT "3) VISIT THE VILLAGE" : GOTO 1060
1040 PRINT "1) TALK TO THE KING" : PRINT "2) WANDER THE FOREST" : PRINT "3) VISIT THE VILLAGE"
1060 INPUT "WHAT DO YOU DO"; C
1070 IF HASCROWN = 1 AND C = 1 THEN WON = 1 : RETURN
1080 IF HASCROWN = 0 AND C = 1 THEN PRINT "THE KING BEGS YOU TO RECOVER HIS STOLEN CROWN FROM THE DRAGON." : RETURN
1090 IF C = 2 THEN ROOM = 2 : RETURN
1100 IF C = 3 THEN ROOM = 3 : RETURN
1110 PRINT "NOTHING HAPPENS." : RETURN
2000 REM --- DARK FOREST ---
2010 PRINT ""
2020 IF VIS2 = 0 THEN PRINT "--- DARK FOREST ---" : PRINT "TWISTED TREES BLOCK THE SUN. PATHS LEAD TO A CAVE AND A RIVER." : VIS2 = 1 ELSE PRINT "--- DARK FOREST ---"
2030 PRINT "1) GO TO THE CAVE  2) GO TO THE RIVER  3) RETURN TO CASTLE"
2040 INPUT "WHAT DO YOU DO"; C
2050 IF C = 1 THEN ROOM = 4 : RETURN
2060 IF C = 2 THEN ROOM = 6 : RETURN
2070 IF C = 3 THEN ROOM = 1 : RETURN
2080 PRINT "NOTHING HAPPENS." : RETURN
3000 REM --- VILLAGE ---
3010 PRINT ""
3020 IF VIS3 = 0 THEN PRINT "--- VILLAGE ---" : PRINT "THE BLACKSMITH RECOGNIZES YOU AND HANDS YOU A FINE SWORD." : HASSWORD = 1 : VIS3 = 1 ELSE PRINT "--- VILLAGE ---" : PRINT "THE BLACKSMITH WAVES HELLO."
3030 PRINT "1) RETURN TO CASTLE"
3040 INPUT "WHAT DO YOU DO"; C
3050 ROOM = 1 : RETURN
4000 REM --- CAVE ---
4010 PRINT ""
4020 IF VIS4 = 0 THEN PRINT "--- CAVE ---" : PRINT "YOU FIND A RUSTY KEY, AND HEAR A BAT SHRIEK OUT OF THE DARK." : HASKEY = 1 : HEALTH = HEALTH - 10 : VIS4 = 1 ELSE PRINT "--- CAVE ---"
4030 PRINT "1) GO DEEPER TO THE DRAGON'S LAIR  2) RETURN TO THE FOREST"
4040 INPUT "WHAT DO YOU DO"; C
4050 IF C = 1 THEN ROOM = 5 : RETURN
4060 IF C = 2 THEN ROOM = 2 : RETURN
4070 PRINT "NOTHING HAPPENS." : RETURN
5000 REM --- DRAGON'S LAIR ---
5010 PRINT ""
5020 PRINT "--- DRAGON'S LAIR ---"
5030 PRINT "THE DRAGON COILS ATOP A GLITTERING CROWN, SMOKE CURLING FROM ITS NOSTRILS."
5040 IF HASSWORD = 0 THEN PRINT "YOU HAVE NO WEAPON. THE DRAGON SWATS YOU AWAY!" : HEALTH = HEALTH - 20 : ROOM = 2 : RETURN
5050 IF HASSWORD = 1 AND HASAMULET = 0 THEN PRINT "YOU CHARGE WITH YOUR SWORD, BUT THE DRAGON'S FIRE SCORCHES YOU!" : HEALTH = HEALTH - 30 : ROOM = 2 : RETURN
5060 PRINT "PROTECTED BY YOUR AMULET, YOU DRIVE YOUR SWORD HOME. THE DRAGON FALLS!"
5070 PRINT "YOU CLAIM THE ENCHANTED CROWN."
5080 HASCROWN = 1
5090 ROOM = 1
5100 RETURN
6000 REM --- RIVERBANK ---
6010 PRINT ""
6020 IF VIS6 = 0 THEN PRINT "--- RIVERBANK ---" : PRINT "A WIDE RIVER BLOCKS YOUR PATH. YOU SPOT A STURDY LOG NEARBY." : VIS6 = 1 ELSE PRINT "--- RIVERBANK ---"
6030 IF HASLOG = 0 THEN PRINT "1) DRAG THE LOG TO THE BANK  2) RETURN TO THE FOREST" ELSE PRINT "1) CROSS TO THE ISLAND ON THE LOG  2) RETURN TO THE FOREST"
6040 INPUT "WHAT DO YOU DO"; C
6050 IF C = 1 AND HASLOG = 0 THEN PRINT "YOU WRESTLE THE LOG INTO PLACE, READY TO CROSS." : HASLOG = 1 : RETURN
6060 IF C = 1 AND HASLOG = 1 THEN ROOM = 7 : RETURN
6070 IF C = 2 THEN ROOM = 2 : RETURN
6080 PRINT "NOTHING HAPPENS." : RETURN
7000 REM --- ISLAND ---
7010 PRINT ""
7020 IF VIS7 = 0 THEN PRINT "--- ISLAND ---" : PRINT "AN ANCIENT AMULET RESTS ON A STONE PEDESTAL, HUMMING WITH MAGIC." : HASAMULET = 1 : VIS7 = 1 ELSE PRINT "--- ISLAND ---"
7030 PRINT "1) CROSS BACK TO THE RIVERBANK"
7040 INPUT "WHAT DO YOU DO"; C
7050 ROOM = 6
7060 RETURN
9000 REM --- VICTORY ---
9010 PRINT ""
9020 PRINT "THE KING PLACES THE ENCHANTED CROWN UPON HIS HEAD, AND COLOR RETURNS"
9030 PRINT "TO HIS CHEEKS. THE KINGDOM IS SAVED, AND YOUR NAME WILL BE SUNG FOR"
9040 PRINT "GENERATIONS."
9050 PRINT ""
9060 PRINT "*** YOU HAVE WON! ***"
9070 END
9100 REM --- DEFEAT ---
9110 PRINT ""
9120 PRINT "YOUR STRENGTH FAILS YOU, AND YOUR QUEST ENDS HERE."
9130 PRINT ""
9140 PRINT "*** GAME OVER ***"
9150 END
