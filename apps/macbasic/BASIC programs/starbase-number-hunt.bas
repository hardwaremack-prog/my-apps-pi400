10 REM ==== STARBASE NUMBER HUNT ====
20 PRINT "STARBASE NUMBER HUNT"
30 PRINT "GUESS THE SECRET NUMBER (1-100) IN AS FEW TRIES AS POSSIBLE."
40 PRINT ""
50 DIM SCORES(3)
60 FOR ROUND = 1 TO 3
70 T = INT(RND(1) * 100) + 1
80 G = 0
90 PRINT "--- ROUND "; ROUND; " ---"
100 GOSUB 500
110 SCORES(ROUND) = G
120 NEXT ROUND
130 PRINT ""
140 PRINT "FINAL RESULTS:"
150 TOTAL = 0
160 FOR ROUND = 1 TO 3
170 PRINT "ROUND "; ROUND; ": "; SCORES(ROUND); " GUESSES"
180 TOTAL = TOTAL + SCORES(ROUND)
190 NEXT ROUND
200 AVG = INT(TOTAL / 3 * 100 + 0.5) / 100
210 PRINT "AVERAGE GUESSES: "; AVG
220 IF AVG <= 5 THEN PRINT "RANK: ACE NAVIGATOR"
230 IF AVG > 5 AND AVG <= 8 THEN PRINT "RANK: SOLID PILOT"
240 IF AVG > 8 THEN PRINT "RANK: KEEP PRACTICING, CADET"
250 END
500 REM --- GUESS LOOP SUBROUTINE ---
510 INPUT "YOUR GUESS"; GS
520 G = G + 1
530 IF GS = T THEN GOTO 570
540 IF GS < T THEN PRINT "TOO LOW"
550 IF GS > T THEN PRINT "TOO HIGH"
560 GOTO 510
570 PRINT "CORRECT! IT TOOK YOU "; G; " GUESSES."
580 RETURN
