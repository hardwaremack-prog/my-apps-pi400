      "gpio": 22,
      "sense_gpio": null
    },
    {
      "id": "D",
      "name": "Position D",
      "meter": "Relay/Collector",
      "gpio": 23,
      "sense_gpio": null
    }
  ],
  "mark_types": [
    {
      "key": "pon_rx",
      "label": "PON received",
      "hint": "Head-end / collector shows last-gasp outage notice"
    },
    {
      "key": "mesh_lost",
      "label": "Dropped from mesh",
      "hint": "Meter no longer seen / no longer routing for neighbours"
    },
    {
      "key": "radio_dark",
      "label": "Radio dark (caps out)",
      "hint": "Last sign of RF activity from the meter"
    },
    {
      "key": "restore_rx",
      "label": "Restore notice",
      "hint": "Power-restoration notice received"
    },
    {
      "key": "rejoined",
      "label": "Rejoined mesh",
      "hint": "Meter back on the network"
    }
  ],
