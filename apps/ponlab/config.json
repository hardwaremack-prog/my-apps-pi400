{
  "_board": "Generic 4-channel 5V opto-isolated relay module (active-low), IN1-IN4 on GPIO 17/27/22/23.",
  "port": 8080,
  "wiring": "NC",
  "relay_active_high": false,
  "max_outage_seconds": 3600,
  "channels": [
    {
      "id": "A",
      "name": "Position A",
      "meter": "Riva meter #1",
      "gpio": 17,
      "sense_gpio": null
